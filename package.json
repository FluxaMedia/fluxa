{
  "name": "fluxa",
  "private": true,
  "version": "0.1.30",
  "scripts": {
    "check:structure": "node scripts/check-monorepo.mjs",
    "generate:i18n": "node scripts/generate-android-i18n.mjs",
    "check:i18n": "node scripts/generate-android-i18n.mjs --check",
    "check": "npm run check:structure && npm run check:i18n && npm run check:desktop && npm run check:core",
    "check:desktop": "npm --prefix apps/desktop run typecheck",
    "test:desktop": "npm --prefix apps/desktop test",
    "test:audio": "./apps/android/gradlew --offline -p apps/android :player:testDebugUnitTest --tests 'com.fluxa.app.shared.feature.player.Audio*Test'",
    "check:android": "./apps/android/gradlew --offline -p apps/android qualityCheck",
    "test:android": "./apps/android/gradlew --offline -p apps/android testDebugUnitTest",
    "check:apple": "./apps/android/gradlew --offline -p apps/android checkAppleTypedCatalogBridge checkAppleTvosKmpBoundary",
    "check:core": "cargo test --manifest-path core/fluxa-core/Cargo.toml --lib --offline",
    "check:wasm": "cargo check --manifest-path core/fluxa-core/Cargo.toml --offline --no-default-features --features wasm",
    "verify:core-consumers": "npm --prefix apps/desktop run core:verify"
  }
}
