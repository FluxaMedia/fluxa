{
  "name": "fluxa-desktop",
  "private": true,
  "version": "0.1.30",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "node scripts/gen-core-methods.mjs && tsc --noEmit",
    "build": "node scripts/gen-core-methods.mjs && tsc && vite build",
    "check": "npm run build && cd src-tauri && cargo check",
    "preview": "vite preview",
    "build:web": "node scripts/gen-core-methods.mjs && tsc && vite build --mode web",
    "build:web:pages": "VITE_BASE_PATH=/fluxa-desktop/ npm run build:web",
    "build:webos": "node scripts/gen-core-methods.mjs && tsc && vite build --mode webos",
    "package:webos": "bash scripts/package-webos.sh",
    "tauri": "tauri",
    "bump": "bash scripts/bump-version.sh"
  },
  "dependencies": {
    "@sentry/react": "^10.64.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "fluxa_core": "file:../fluxa-core/pkg",
    "jassub": "^2.5.14",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.22.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
