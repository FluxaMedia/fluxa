{
  "type": "column",
  "class": "screen gap-14 items-stretch",
  "children": [
    {
      "type": "spacer",
      "class": "h-72"
    },
    {
      "type": "page",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "i18n": "nav.library",
              "style": "title"
            },
            {
              "type": "spacer",
              "class": "grow"
            },
            {
              "type": "text",
              "text": "{calendar.title}",
              "style": "subtitle"
            },
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "ArrowLeft"
                  }
                }
              ],
              "action": {
                "name": "calendar_month",
                "args": {
                  "delta": -1
                }
              }
            },
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "ArrowRight"
                  }
                }
              ],
              "action": {
                "name": "calendar_month",
                "args": {
                  "delta": 1
                }
              }
            }
          ],
          "class": "gap-12 items-center fill-space"
        },
        {
          "include": "section_tabs"
        },
        {
          "type": "text",
          "i18n": "calendar.empty",
          "style": "meta muted",
          "when": "!calendar.valid"
        }
      ],
      "class": "gap-14"
    },
    {
      "type": "grid",
      "props": {
        "columns": 7
      },
      "when": "calendar.valid",
      "children": [
        {
          "each": "calendar.weekdays",
          "as": "day",
          "template": {
            "type": "text",
            "text": "{day.label}",
            "style": "meta muted"
          }
        }
      ],
      "class": "gap-8"
    },
    {
      "type": "grid",
      "props": {
        "columns": 7
      },
      "when": "calendar.valid",
      "children": [
        {
          "each": "calendar.cells",
          "as": "cell",
          "template": {
            "include": "day_cell"
          }
        }
      ],
      "class": "gap-8"
    },
    {
      "type": "page",
      "when": "len(calendar.selected) > 0",
      "children": [
        {
          "type": "text",
          "i18n": "calendar.releases",
          "style": "subtitle"
        }
      ],
      "class": "gap-12"
    },
    {
      "type": "grid",
      "class": "poster-grid",
      "when": "len(calendar.selected) > 0",
      "children": [
        {
          "each": "calendar.selected",
          "as": "card",
          "template": {
            "include": "card"
          }
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "w-100vw h-100vh pad-0-0-16-0 items-center justify-flex-end compact-only nav-dock"
        }
      ]
    }
  ]
}
