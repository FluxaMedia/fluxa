{
  "type": "column",
  "class": "screen library",
  "children": [
    {
      "type": "spacer",
      "class": "lead"
    },
    {
      "type": "page",
      "children": [
        {
          "type": "row",
          "tag": "header",
          "class": "fill-space",
          "children": [
            {
              "type": "text",
              "tag": "h1",
              "i18n": "nav.library"
            },
            {
              "type": "spacer",
              "class": "grow"
            },
            {
              "type": "text",
              "tag": "h4",
              "text": "{calendar.title}"
            },
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "ArrowLeft"
                  }
                }
              ],
              "action": {
                "name": "calendar_month",
                "args": {
                  "delta": -1
                }
              }
            },
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "ArrowRight"
                  }
                }
              ],
              "action": {
                "name": "calendar_month",
                "args": {
                  "delta": 1
                }
              }
            }
          ]
        },
        {
          "include": "section_tabs"
        },
        {
          "type": "text",
          "tag": "small",
          "i18n": "calendar.empty",
          "when": "!calendar.valid"
        }
      ],
      "class": "page-dense listing"
    },
    {
      "type": "grid",
      "props": {
        "columns": 7
      },
      "when": "calendar.valid",
      "children": [
        {
          "each": "calendar.weekdays",
          "as": "day",
          "template": {
            "type": "text",
            "tag": "small",
            "text": "{day.label}"
          }
        }
      ],
      "class": "day-grid"
    },
    {
      "type": "grid",
      "props": {
        "columns": 7
      },
      "when": "calendar.valid",
      "children": [
        {
          "each": "calendar.cells",
          "as": "cell",
          "template": {
            "include": "day_cell"
          }
        }
      ],
      "class": "day-grid"
    },
    {
      "type": "page",
      "when": "len(calendar.selected) > 0",
      "children": [
        {
          "type": "text",
          "tag": "h4",
          "i18n": "calendar.releases"
        }
      ],
      "class": "page-snug"
    },
    {
      "type": "grid",
      "class": "poster-grid",
      "when": "len(calendar.selected) > 0",
      "children": [
        {
          "each": "calendar.selected",
          "as": "card",
          "template": {
            "include": "card"
          }
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "compact-only nav-dock"
        }
      ]
    }
  ]
}
