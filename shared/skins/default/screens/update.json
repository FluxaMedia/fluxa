{
  "type": "stack",
  "children": [
    {
      "type": "column",
      "class": "menu-scrim fill-space",
      "action": {
        "name": "update",
        "args": {
          "op": "later"
        }
      }
    },
    {
      "type": "column",
      "children": [
        {
          "type": "column",
          "class": "popover menu-panel panel-box",
          "width": "{const.dialogWidth}",
          "children": [
            {
              "type": "row",
              "tag": "header",
              "children": [
                {
                  "type": "text",
                  "tag": "h4",
                  "i18n": "update.popup_title"
                },
                {
                  "type": "text",
                  "tag": "h4",
                  "text": "v{update.version}"
                }
              ]
            },
            {
              "type": "text",
              "tag": "small",
              "i18n": "update.popup_body"
            },
            {
              "type": "row",
              "tag": "footer",
              "children": [
                {
                  "type": "row",
                  "tag": "button",
                  "action": {
                    "name": "update",
                    "args": {
                      "op": "download"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "i18n": "update.download_only"
                    }
                  ]
                },
                {
                  "type": "row",
                  "tag": "button",
                  "class": "primary",
                  "action": {
                    "name": "update",
                    "args": {
                      "op": "install"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "i18n": "update.download_install"
                    }
                  ]
                }
              ],
              "class": "split"
            }
          ]
        }
      ],
      "class": "fullscreen centered fullscreen-center"
    }
  ],
  "class": "fullscreen"
}
