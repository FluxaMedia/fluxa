{
  "type": "stack",
  "children": [
    {
      "type": "column",
      "class": "menu-scrim fill-space",
      "action": {
        "name": "update",
        "args": {
          "op": "later"
        }
      }
    },
    {
      "type": "column",
      "children": [
        {
          "type": "column",
          "class": "popover menu-panel",
          "gap": 12,
          "padding": 20,
          "width": "{const.dialogWidth}",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "text",
                  "i18n": "update.popup_title",
                  "style": "subtitle"
                },
                {
                  "type": "text",
                  "text": "v{update.version}",
                  "style": "subtitle"
                }
              ],
              "gap": 6
            },
            {
              "type": "text",
              "i18n": "update.popup_body",
              "style": "meta muted"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "btn-secondary button-fill",
                  "grow": 1,
                  "action": {
                    "name": "update",
                    "args": {
                      "op": "download"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "i18n": "update.download_only",
                      "class": "btn-label"
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "btn-primary button-fill",
                  "grow": 1,
                  "action": {
                    "name": "update",
                    "args": {
                      "op": "install"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "i18n": "update.download_install",
                      "class": "btn-label"
                    }
                  ]
                }
              ],
              "gap": 8
            }
          ]
        }
      ],
      "class": "fullscreen centered fullscreen-center"
    }
  ],
  "class": "fullscreen"
}
