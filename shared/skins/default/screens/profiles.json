{
  "type": "stack",
  "children": [
    {
      "type": "column",
      "class": "screen wide-only w-100vw h-100vh gap-28 items-center justify-center",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "text": "{profiles.title}",
              "style": "headline"
            },
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "Settings"
                  }
                }
              ],
              "action": {
                "name": "profiles",
                "args": {
                  "op": "gear"
                }
              }
            }
          ],
          "class": "gap-12 items-center justify-center"
        },
        {
          "type": "column",
          "children": [
            {
              "type": "grid",
              "props": {
                "columns": "{profiles.columns}"
              },
              "children": [
                {
                  "each": "profiles.items",
                  "as": "item",
                  "template": {
                    "type": "column",
                    "children": [
                      {
                        "include": "profile_tile",
                        "when": "!profiles.manage"
                      },
                      {
                        "include": "profile_tile_manage",
                        "when": "profiles.manage"
                      }
                    ],
                    "class": "items-center"
                  }
                },
                {
                  "include": "profile_add",
                  "when": "profiles.showAdd"
                }
              ],
              "width": "{profiles.gridWidth}"
            }
          ],
          "class": "items-center"
        },
        {
          "type": "row",
          "when": "!profiles.empty",
          "children": [
            {
              "type": "row",
              "class": "btn-secondary pad-0-28 justify-center",
              "children": [
                {
                  "type": "text",
                  "class": "btn-label",
                  "text": "{profiles.manageLabel}"
                }
              ],
              "action": {
                "name": "profiles",
                "args": {
                  "op": "manage"
                }
              }
            }
          ],
          "class": "justify-center"
        }
      ],
      "when": "profiles.isSelect"
    },
    {
      "type": "column",
      "class": "screen compact-only w-100vw h-100vh gap-28 pad-72-0-0-0 items-center",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "text": "{profiles.title}",
              "style": "headline"
            },
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "Settings"
                  }
                }
              ],
              "action": {
                "name": "profiles",
                "args": {
                  "op": "gear"
                }
              }
            }
          ],
          "class": "gap-12 items-center justify-center"
        },
        {
          "type": "column",
          "children": [
            {
              "type": "grid",
              "props": {
                "columns": "{profiles.columns}"
              },
              "children": [
                {
                  "each": "profiles.items",
                  "as": "item",
                  "template": {
                    "type": "column",
                    "children": [
                      {
                        "include": "profile_tile",
                        "when": "!profiles.manage"
                      },
                      {
                        "include": "profile_tile_manage",
                        "when": "profiles.manage"
                      }
                    ],
                    "class": "items-center"
                  }
                },
                {
                  "include": "profile_add",
                  "when": "profiles.showAdd"
                }
              ],
              "width": "{profiles.gridWidth}"
            }
          ],
          "class": "items-center"
        },
        {
          "type": "row",
          "when": "!profiles.empty",
          "children": [
            {
              "type": "row",
              "class": "btn-secondary pad-0-28 justify-center",
              "children": [
                {
                  "type": "text",
                  "class": "btn-label",
                  "text": "{profiles.manageLabel}"
                }
              ],
              "action": {
                "name": "profiles",
                "args": {
                  "op": "manage"
                }
              }
            }
          ],
          "class": "justify-center"
        }
      ],
      "when": "profiles.isSelect"
    },
    {
      "type": "column",
      "when": "profiles.isForm",
      "class": "screen w-100vw h-100vh gap-14 pad-48-0-0-0 items-center",
      "children": [
        {
          "type": "column",
          "class": "profile-form",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "back"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "ArrowLeft"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "{profiles.form.title}",
                  "style": "title",
                  "class": "grow"
                }
              ],
              "class": "gap-12 items-center"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "avatars"
                    }
                  },
                  "children": [
                    {
                      "include": "avatar",
                      "with": {
                        "image": "profiles.form.avatar",
                        "name": "profiles.form.name",
                        "size": "64",
                        "badge": "\"\"",
                        "ring": "-1"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "{profiles.form.name}",
                  "style": "subtitle",
                  "class": "grow wide-only"
                },
                {
                  "type": "column",
                  "children": [],
                  "class": "compact-only grow"
                },
                {
                  "type": "text",
                  "when": "profiles.form.primary",
                  "i18n": "profiles.primary_badge",
                  "style": "meta muted"
                },
                {
                  "type": "row",
                  "class": "btn-secondary pad-0-24 justify-center",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "avatars"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "i18n": "profiles.choose_icon"
                    }
                  ]
                }
              ],
              "class": "gap-14 pad-8-0 items-center"
            },
            {
              "type": "text",
              "i18n": "profiles.name",
              "style": "meta muted"
            },
            {
              "type": "input",
              "props": {
                "key": "profileName",
                "placeholder": "{profiles.form.nameHint}",
                "value": "{fields.profileName}",
                "kind": "text"
              },
              "class": "fill-space"
            },
            {
              "type": "text",
              "when": "profiles.form.duplicate",
              "i18n": "profiles.duplicate_name",
              "style": "meta"
            },
            {
              "type": "text",
              "i18n": "profiles.image_url",
              "style": "meta muted"
            },
            {
              "type": "input",
              "props": {
                "key": "profileUrl",
                "placeholder": "{profiles.form.urlHint}",
                "value": "{fields.profileUrl}",
                "kind": "url"
              },
              "class": "fill-space"
            },
            {
              "type": "text",
              "i18n": "profiles.pin_lock",
              "style": "meta muted"
            },
            {
              "type": "input",
              "props": {
                "key": "profilePin",
                "placeholder": "{profiles.form.pinHint}",
                "value": "{fields.profilePin}",
                "kind": "password"
              },
              "class": "fill-space"
            },
            {
              "type": "text",
              "when": "profiles.form.pinInvalid",
              "i18n": "profiles.pin_invalid",
              "style": "meta"
            },
            {
              "type": "text",
              "when": "profiles.form.pinRemoved",
              "i18n": "profiles.pin_will_be_removed",
              "style": "meta muted"
            },
            {
              "type": "row",
              "when": "profiles.form.pinSet",
              "action": {
                "name": "profiles",
                "args": {
                  "op": "remove_pin"
                }
              },
              "children": [
                {
                  "type": "text",
                  "i18n": "profiles.remove_pin",
                  "style": "meta"
                }
              ]
            },
            {
              "type": "column",
              "when": "profiles.form.shared",
              "children": [
                {
                  "type": "text",
                  "i18n": "profiles.sharing",
                  "style": "meta muted"
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "i18n": "profiles.use_primary_addons",
                      "class": "grow"
                    },
                    {
                      "type": "row",
                      "class": "switch w-46 h-28 pad-3-3-3-3 items-center",
                      "props": {
                        "selected": "profiles.form.addons"
                      },
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "toggle_addons"
                        }
                      },
                      "children": [
                        {
                          "type": "spacer",
                          "when": "profiles.form.addons",
                          "class": "grow"
                        },
                        {
                          "type": "column",
                          "class": "knob w-22 h-22"
                        },
                        {
                          "type": "spacer",
                          "when": "!profiles.form.addons",
                          "class": "grow"
                        }
                      ]
                    }
                  ],
                  "class": "gap-12 pad-6-0 items-center"
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "text",
                      "i18n": "profiles.use_primary_plugins",
                      "class": "grow"
                    },
                    {
                      "type": "row",
                      "class": "switch w-46 h-28 pad-3-3-3-3 items-center",
                      "props": {
                        "selected": "profiles.form.plugins"
                      },
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "toggle_plugins"
                        }
                      },
                      "children": [
                        {
                          "type": "spacer",
                          "when": "profiles.form.plugins",
                          "class": "grow"
                        },
                        {
                          "type": "column",
                          "class": "knob w-22 h-22"
                        },
                        {
                          "type": "spacer",
                          "when": "!profiles.form.plugins",
                          "class": "grow"
                        }
                      ]
                    }
                  ],
                  "class": "gap-12 pad-6-0 items-center"
                }
              ],
              "class": "gap-4 items-stretch"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "btn-secondary pad-0-24 justify-center grow",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "back"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "i18n": "common.cancel"
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "btn-primary justify-center grow",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "save"
                    }
                  },
                  "when": "profiles.form.canSave",
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{profiles.form.saveLabel}"
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "btn-secondary justify-center grow",
                  "when": "!profiles.form.canSave",
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{profiles.form.saveLabel}",
                      "style": "muted"
                    }
                  ]
                }
              ],
              "class": "gap-8 pad-12-0-0-0"
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "when": "profiles.isAvatars",
      "class": "screen w-100vw h-100vh gap-14 pad-48-0-0-0 items-center",
      "children": [
        {
          "type": "column",
          "class": "profile-form",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "back"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "ArrowLeft"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "i18n": "profiles.choose_icon",
                  "style": "title",
                  "class": "grow"
                }
              ],
              "class": "gap-12 items-center"
            },
            {
              "type": "text",
              "i18n": "profiles.choose_icon_desc",
              "style": "meta muted"
            },
            {
              "type": "text",
              "when": "profiles.avatars.empty",
              "i18n": "profiles.no_avatar_packs",
              "style": "meta muted"
            },
            {
              "each": "profiles.avatars.packs",
              "as": "pack",
              "template": {
                "type": "column",
                "children": [
                  {
                    "type": "row",
                    "children": [
                      {
                        "type": "text",
                        "text": "{pack.title}",
                        "style": "subtitle"
                      },
                      {
                        "type": "text",
                        "text": "{pack.count}",
                        "style": "meta muted"
                      }
                    ],
                    "class": "gap-8 items-center"
                  },
                  {
                    "type": "grid",
                    "props": {
                      "columns": "6"
                    },
                    "width": "{const.formWidth}",
                    "children": [
                      {
                        "each": "pack.items",
                        "as": "avatar",
                        "template": {
                          "type": "row",
                          "class": "avatar-choice",
                          "props": {
                            "selected": "{avatar.selected}"
                          },
                          "action": {
                            "name": "profiles",
                            "args": {
                              "op": "avatar_pick",
                              "index": "{avatar.index}"
                            }
                          },
                          "children": [
                            {
                              "include": "avatar",
                              "with": {
                                "image": "avatar.url",
                                "name": "avatar.name",
                                "size": "56",
                                "badge": "\"\"",
                                "ring": "-1"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "class": "wide-only"
                  },
                  {
                    "type": "grid",
                    "props": {
                      "columns": "4"
                    },
                    "children": [
                      {
                        "each": "pack.items",
                        "as": "avatar",
                        "template": {
                          "type": "row",
                          "class": "avatar-choice",
                          "props": {
                            "selected": "{avatar.selected}"
                          },
                          "action": {
                            "name": "profiles",
                            "args": {
                              "op": "avatar_pick",
                              "index": "{avatar.index}"
                            }
                          },
                          "children": [
                            {
                              "include": "avatar",
                              "with": {
                                "image": "avatar.url",
                                "name": "avatar.name",
                                "size": "56",
                                "badge": "\"\"",
                                "ring": "-1"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "class": "compact-only w-88vw"
                  }
                ],
                "class": "gap-8 items-stretch"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "when": "profiles.isSettings",
      "class": "screen w-100vw h-100vh gap-14 pad-48-0-0-0 items-center",
      "children": [
        {
          "type": "column",
          "class": "profile-form",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "back"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "ArrowLeft"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "i18n": "profiles.picker_settings",
                  "style": "title",
                  "class": "grow"
                }
              ],
              "class": "gap-12 items-center"
            },
            {
              "type": "text",
              "i18n": "profiles.picker_background",
              "style": "subtitle"
            },
            {
              "type": "text",
              "i18n": "profiles.picker_background_desc",
              "style": "meta muted"
            },
            {
              "type": "input",
              "props": {
                "key": "pickerBackground",
                "placeholder": "{profiles.settings.backgroundHint}",
                "value": "{fields.pickerBackground}",
                "kind": "url"
              },
              "class": "fill-space"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "btn-secondary pad-0-24 justify-center grow",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "background_pick"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "i18n": "profiles.choose_image"
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "btn-secondary pad-0-24 justify-center grow",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "background_clear"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "i18n": "profiles.clear_background"
                    }
                  ],
                  "when": "profiles.settings.hasBackground"
                }
              ],
              "class": "gap-8"
            },
            {
              "type": "text",
              "i18n": "profiles.avatar_packs",
              "style": "subtitle",
              "class": "pad-12-0-0-0"
            },
            {
              "type": "text",
              "i18n": "profiles.avatar_packs_desc",
              "style": "meta muted"
            },
            {
              "type": "input",
              "props": {
                "key": "packRepository",
                "placeholder": "{profiles.settings.repositoryHint}",
                "value": "{fields.packRepository}",
                "kind": "url"
              },
              "class": "fill-space"
            },
            {
              "type": "row",
              "class": "btn-primary pad-0-24 justify-center",
              "action": {
                "name": "profiles",
                "args": {
                  "op": "pack_add"
                }
              },
              "children": [
                {
                  "type": "text",
                  "class": "btn-label",
                  "i18n": "profiles.add_pack"
                }
              ],
              "when": "profiles.settings.canAdd"
            },
            {
              "type": "row",
              "class": "btn-secondary justify-center",
              "when": "!profiles.settings.canAdd",
              "children": [
                {
                  "type": "text",
                  "class": "btn-label",
                  "i18n": "profiles.add_pack",
                  "style": "muted"
                }
              ]
            },
            {
              "type": "text",
              "when": "profiles.settings.empty",
              "i18n": "profiles.no_avatar_packs",
              "style": "meta muted"
            },
            {
              "each": "profiles.settings.packs",
              "as": "pack",
              "template": {
                "type": "row",
                "children": [
                  {
                    "type": "column",
                    "children": [
                      {
                        "type": "text",
                        "text": "{pack.title}",
                        "style": "subtitle"
                      },
                      {
                        "type": "text",
                        "text": "{pack.count}",
                        "style": "meta muted"
                      }
                    ],
                    "class": "grow"
                  },
                  {
                    "type": "row",
                    "class": "btn-secondary pad-0-24 justify-center",
                    "action": {
                      "name": "profiles",
                      "args": {
                        "op": "pack_refresh",
                        "index": "{pack.index}"
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "class": "btn-label",
                        "i18n": "profiles.refresh_pack"
                      }
                    ]
                  },
                  {
                    "type": "row",
                    "class": "btn-secondary pad-0-24 justify-center",
                    "action": {
                      "name": "profiles",
                      "args": {
                        "op": "pack_remove",
                        "index": "{pack.index}"
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "class": "btn-label",
                        "i18n": "profiles.remove_pack"
                      }
                    ]
                  }
                ],
                "class": "gap-8 items-center"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "stack",
      "when": "profiles.pin",
      "children": [
        {
          "type": "column",
          "class": "menu-scrim fill-space",
          "action": {
            "name": "profiles",
            "args": {
              "op": "pin_cancel"
            }
          }
        },
        {
          "type": "column",
          "children": [
            {
              "type": "column",
              "class": "menu-panel gap-12 pad-20 items-stretch",
              "width": "{const.dialogWidth}",
              "children": [
                {
                  "type": "row",
                  "children": [
                    {
                      "include": "avatar",
                      "with": {
                        "image": "profiles.pin.avatar",
                        "name": "profiles.pin.name",
                        "size": "36",
                        "badge": "\"\"",
                        "ring": "-1"
                      }
                    },
                    {
                      "type": "text",
                      "text": "{profiles.pin.name}",
                      "style": "subtitle"
                    }
                  ],
                  "class": "gap-12 items-center"
                },
                {
                  "type": "text",
                  "i18n": "profiles.pin_prompt",
                  "style": "meta muted"
                },
                {
                  "type": "input",
                  "props": {
                    "key": "profileUnlock",
                    "placeholder": "{profiles.pin.hint}",
                    "value": "{fields.profileUnlock}",
                    "kind": "password"
                  },
                  "width": "{const.dialogInput}"
                },
                {
                  "type": "text",
                  "when": "profiles.pin.error",
                  "text": "{profiles.pin.error}",
                  "style": "meta"
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "row",
                      "class": "btn-secondary pad-0-24 justify-center grow",
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "pin_cancel"
                        }
                      },
                      "children": [
                        {
                          "type": "text",
                          "class": "btn-label",
                          "i18n": "common.cancel"
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "class": "btn-primary pad-0-24 justify-center grow",
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "pin_unlock"
                        }
                      },
                      "children": [
                        {
                          "type": "text",
                          "class": "btn-label",
                          "i18n": "profiles.unlock"
                        }
                      ]
                    }
                  ],
                  "class": "gap-8"
                }
              ]
            }
          ],
          "class": "w-100vw h-100vh items-center justify-center"
        }
      ],
