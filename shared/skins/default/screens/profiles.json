{
  "type": "stack",
  "children": [
    {
      "type": "column",
      "class": "screen wide-only fullscreen pick centered",
      "children": [
        {
          "type": "row",
          "tag": "header",
          "children": [
            {
              "type": "text",
              "text": "{profiles.title}",
              "style": "headline"
            },
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "Settings"
                  }
                }
              ],
              "action": {
                "name": "profiles",
                "args": {
                  "op": "gear"
                }
              }
            }
          ]
        },
        {
          "type": "column",
          "tag": "section",
          "children": [
            {
              "type": "grid",
              "props": {
                "columns": "{profiles.columns}"
              },
              "children": [
                {
                  "each": "profiles.items",
                  "as": "item",
                  "template": {
                    "type": "column",
                    "tag": "li",
                    "children": [
                      {
                        "include": "profile_tile",
                        "when": "!profiles.manage"
                      },
                      {
                        "include": "profile_tile_manage",
                        "when": "profiles.manage"
                      }
                    ]
                  }
                },
                {
                  "include": "profile_add",
                  "when": "profiles.showAdd"
                }
              ],
              "width": "{profiles.gridWidth}"
            }
          ]
        },
        {
          "type": "row",
          "tag": "footer",
          "when": "!profiles.empty",
          "children": [
            {
              "type": "row",
              "tag": "button",
              "children": [
                {
                  "type": "text",
                  "tag": "span",
                  "text": "{profiles.manageLabel}"
                }
              ],
              "action": {
                "name": "profiles",
                "args": {
                  "op": "manage"
                }
              }
            }
          ]
        }
      ],
      "when": "profiles.isSelect"
    },
    {
      "type": "column",
      "class": "screen compact-only fullscreen pick pick-compact",
      "children": [
        {
          "type": "row",
          "tag": "header",
          "children": [
            {
              "type": "text",
              "text": "{profiles.title}",
              "style": "headline"
            },
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "Settings"
                  }
                }
              ],
              "action": {
                "name": "profiles",
                "args": {
                  "op": "gear"
                }
              }
            }
          ]
        },
        {
          "type": "column",
          "tag": "section",
          "children": [
            {
              "type": "grid",
              "props": {
                "columns": "{profiles.columns}"
              },
              "children": [
                {
                  "each": "profiles.items",
                  "as": "item",
                  "template": {
                    "type": "column",
                    "tag": "li",
                    "children": [
                      {
                        "include": "profile_tile",
                        "when": "!profiles.manage"
                      },
                      {
                        "include": "profile_tile_manage",
                        "when": "profiles.manage"
                      }
                    ]
                  }
                },
                {
                  "include": "profile_add",
                  "when": "profiles.showAdd"
                }
              ],
              "width": "{profiles.gridWidth}"
            }
          ]
        },
        {
          "type": "row",
          "tag": "footer",
          "when": "!profiles.empty",
          "children": [
            {
              "type": "row",
              "tag": "button",
              "children": [
                {
                  "type": "text",
                  "tag": "span",
                  "text": "{profiles.manageLabel}"
                }
              ],
              "action": {
                "name": "profiles",
                "args": {
                  "op": "manage"
                }
              }
            }
          ]
        }
      ],
      "when": "profiles.isSelect"
    },
    {
      "type": "column",
      "when": "profiles.isForm",
      "class": "screen fullscreen profile-page",
      "children": [
        {
          "type": "column",
          "class": "profile-form",
          "children": [
            {
              "type": "row",
              "tag": "header",
              "children": [
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "back"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "ArrowLeft"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "tag": "h1",
                  "text": "{profiles.form.title}"
                }
              ]
            },
            {
              "type": "row",
              "tag": "section",
              "class": "identity",
              "children": [
                {
                  "type": "row",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "avatars"
                    }
                  },
                  "children": [
                    {
                      "include": "avatar",
                      "with": {
                        "image": "profiles.form.avatar",
                        "name": "profiles.form.name",
                        "size": "64",
                        "badge": "\"\"",
                        "ring": "-1"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "tag": "h4",
                  "class": "wide-only",
                  "text": "{profiles.form.name}"
                },
                {
                  "type": "column",
                  "children": [],
                  "class": "compact-only grow"
                },
                {
                  "type": "text",
                  "tag": "small",
                  "when": "profiles.form.primary",
                  "i18n": "profiles.primary_badge"
                },
                {
                  "type": "row",
                  "tag": "button",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "avatars"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "i18n": "profiles.choose_icon"
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "tag": "small",
              "i18n": "profiles.name"
            },
            {
              "type": "input",
              "props": {
                "key": "profileName",
                "placeholder": "{profiles.form.nameHint}",
                "value": "{fields.profileName}",
                "kind": "text"
              },
              "class": "fill-space"
            },
            {
              "type": "text",
              "when": "profiles.form.duplicate",
              "i18n": "profiles.duplicate_name",
              "style": "meta"
            },
            {
              "type": "text",
              "tag": "small",
              "i18n": "profiles.image_url"
            },
            {
              "type": "input",
              "props": {
                "key": "profileUrl",
                "placeholder": "{profiles.form.urlHint}",
                "value": "{fields.profileUrl}",
                "kind": "url"
              },
              "class": "fill-space"
            },
            {
              "type": "text",
              "tag": "small",
              "i18n": "profiles.pin_lock"
            },
            {
              "type": "input",
              "props": {
                "key": "profilePin",
                "placeholder": "{profiles.form.pinHint}",
                "value": "{fields.profilePin}",
                "kind": "password"
              },
              "class": "fill-space"
            },
            {
              "type": "text",
              "when": "profiles.form.pinInvalid",
              "i18n": "profiles.pin_invalid",
              "style": "meta"
            },
            {
              "type": "text",
              "tag": "small",
              "when": "profiles.form.pinRemoved",
              "i18n": "profiles.pin_will_be_removed"
            },
            {
              "type": "row",
              "when": "profiles.form.pinSet",
              "action": {
                "name": "profiles",
                "args": {
                  "op": "remove_pin"
                }
              },
              "children": [
                {
                  "type": "text",
                  "i18n": "profiles.remove_pin",
                  "style": "meta"
                }
              ]
            },
            {
              "type": "column",
              "tag": "section",
              "class": "sharing",
              "when": "profiles.form.shared",
              "children": [
                {
                  "type": "text",
                  "tag": "small",
                  "i18n": "profiles.sharing"
                },
                {
                  "type": "row",
                  "tag": "li",
                  "children": [
                    {
                      "type": "text",
                      "tag": "label",
                      "i18n": "profiles.use_primary_addons"
                    },
                    {
                      "type": "row",
                      "class": "switch",
                      "props": {
                        "selected": "profiles.form.addons"
                      },
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "toggle_addons"
                        }
                      },
                      "children": [
                        {
                          "type": "spacer",
                          "when": "profiles.form.addons",
                          "class": "grow"
                        },
                        {
                          "type": "column",
                          "class": "knob"
                        },
                        {
                          "type": "spacer",
                          "when": "!profiles.form.addons",
                          "class": "grow"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "row",
                  "tag": "li",
                  "children": [
                    {
                      "type": "text",
                      "tag": "label",
                      "i18n": "profiles.use_primary_plugins"
                    },
                    {
                      "type": "row",
                      "class": "switch",
                      "props": {
                        "selected": "profiles.form.plugins"
                      },
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "toggle_plugins"
                        }
                      },
                      "children": [
                        {
                          "type": "spacer",
                          "when": "profiles.form.plugins",
                          "class": "grow"
                        },
                        {
                          "type": "column",
                          "class": "knob"
                        },
                        {
                          "type": "spacer",
                          "when": "!profiles.form.plugins",
                          "class": "grow"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "row",
              "tag": "footer",
              "class": "split",
              "children": [
                {
                  "type": "row",
                  "tag": "button",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "back"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "i18n": "common.cancel"
                    }
                  ]
                },
                {
                  "type": "row",
                  "tag": "button",
                  "class": "primary",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "save"
                    }
                  },
                  "when": "profiles.form.canSave",
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "text": "{profiles.form.saveLabel}"
                    }
                  ]
                },
                {
                  "type": "row",
                  "tag": "button",
                  "when": "!profiles.form.canSave",
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "text": "{profiles.form.saveLabel}",
                      "style": "muted"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "when": "profiles.isAvatars",
      "class": "screen fullscreen profile-page",
      "children": [
        {
          "type": "column",
          "class": "profile-form",
          "children": [
            {
              "type": "row",
              "tag": "header",
              "children": [
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "back"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "ArrowLeft"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "tag": "h1",
                  "i18n": "profiles.choose_icon"
                }
              ]
            },
            {
              "type": "text",
              "tag": "small",
              "i18n": "profiles.choose_icon_desc"
            },
            {
              "type": "text",
              "tag": "small",
              "when": "profiles.avatars.empty",
              "i18n": "profiles.no_avatar_packs"
            },
            {
              "each": "profiles.avatars.packs",
              "as": "pack",
              "template": {
                "type": "column",
                "tag": "section",
                "class": "pack",
                "children": [
                  {
                    "type": "row",
                    "tag": "header",
                    "children": [
                      {
                        "type": "text",
                        "tag": "h4",
                        "text": "{pack.title}"
                      },
                      {
                        "type": "text",
                        "tag": "small",
                        "text": "{pack.count}"
                      }
                    ]
                  },
                  {
                    "type": "grid",
                    "props": {
                      "columns": "6"
                    },
                    "width": "{const.formWidth}",
                    "children": [
                      {
                        "each": "pack.items",
                        "as": "avatar",
                        "template": {
                          "type": "row",
                          "class": "centered avatar-choice",
                          "props": {
                            "selected": "{avatar.selected}"
                          },
                          "action": {
                            "name": "profiles",
                            "args": {
                              "op": "avatar_pick",
                              "index": "{avatar.index}"
                            }
                          },
                          "children": [
                            {
                              "include": "avatar",
                              "with": {
                                "image": "avatar.url",
                                "name": "avatar.name",
                                "size": "56",
                                "badge": "\"\"",
                                "ring": "-1"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "class": "wide-only"
                  },
                  {
                    "type": "grid",
                    "props": {
                      "columns": "4"
                    },
                    "children": [
                      {
                        "each": "pack.items",
                        "as": "avatar",
                        "template": {
                          "type": "row",
                          "class": "centered avatar-choice",
                          "props": {
                            "selected": "{avatar.selected}"
                          },
                          "action": {
                            "name": "profiles",
                            "args": {
                              "op": "avatar_pick",
                              "index": "{avatar.index}"
                            }
                          },
                          "children": [
                            {
                              "include": "avatar",
                              "with": {
                                "image": "avatar.url",
                                "name": "avatar.name",
                                "size": "56",
                                "badge": "\"\"",
                                "ring": "-1"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "class": "compact-only choices"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "when": "profiles.isSettings",
      "class": "screen fullscreen profile-page",
      "children": [
        {
          "type": "column",
          "class": "profile-form",
          "children": [
            {
              "type": "row",
              "tag": "header",
              "children": [
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "back"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "ArrowLeft"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "tag": "h1",
                  "i18n": "profiles.picker_settings"
                }
              ]
            },
            {
              "type": "text",
              "tag": "h4",
              "i18n": "profiles.picker_background"
            },
            {
              "type": "text",
              "tag": "small",
              "i18n": "profiles.picker_background_desc"
            },
            {
              "type": "input",
              "props": {
                "key": "pickerBackground",
                "placeholder": "{profiles.settings.backgroundHint}",
                "value": "{fields.pickerBackground}",
                "kind": "url"
              },
              "class": "fill-space"
            },
            {
              "type": "row",
              "tag": "footer",
              "class": "split",
              "children": [
                {
                  "type": "row",
                  "tag": "button",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "background_pick"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "i18n": "profiles.choose_image"
                    }
                  ]
                },
                {
                  "type": "row",
                  "tag": "button",
                  "action": {
                    "name": "profiles",
                    "args": {
                      "op": "background_clear"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "i18n": "profiles.clear_background"
                    }
                  ],
                  "when": "profiles.settings.hasBackground"
                }
              ]
            },
            {
              "type": "text",
              "tag": "h4",
              "i18n": "profiles.avatar_packs",
              "class": "spaced"
            },
            {
              "type": "text",
              "tag": "small",
              "i18n": "profiles.avatar_packs_desc"
            },
            {
              "type": "input",
              "props": {
                "key": "packRepository",
                "placeholder": "{profiles.settings.repositoryHint}",
                "value": "{fields.packRepository}",
                "kind": "url"
              },
              "class": "fill-space"
            },
            {
              "type": "row",
              "tag": "button",
              "class": "primary",
              "action": {
                "name": "profiles",
                "args": {
                  "op": "pack_add"
                }
              },
              "children": [
                {
                  "type": "text",
                  "tag": "span",
                  "i18n": "profiles.add_pack"
                }
              ],
              "when": "profiles.settings.canAdd"
            },
            {
              "type": "row",
              "tag": "button",
              "when": "!profiles.settings.canAdd",
              "children": [
                {
                  "type": "text",
                  "tag": "span",
                  "i18n": "profiles.add_pack",
                  "style": "muted"
                }
              ]
            },
            {
              "type": "text",
              "tag": "small",
              "when": "profiles.settings.empty",
              "i18n": "profiles.no_avatar_packs"
            },
            {
              "each": "profiles.settings.packs",
              "as": "pack",
              "template": {
                "type": "row",
                "tag": "li",
                "children": [
                  {
                    "type": "column",
                    "tag": "div",
                    "children": [
                      {
                        "type": "text",
                        "tag": "h4",
                        "text": "{pack.title}"
                      },
                      {
                        "type": "text",
                        "tag": "small",
                        "text": "{pack.count}"
                      }
                    ]
                  },
                  {
                    "type": "row",
                    "tag": "button",
                    "action": {
                      "name": "profiles",
                      "args": {
                        "op": "pack_refresh",
                        "index": "{pack.index}"
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "tag": "span",
                        "i18n": "profiles.refresh_pack"
                      }
                    ]
                  },
                  {
                    "type": "row",
                    "tag": "button",
                    "action": {
                      "name": "profiles",
                      "args": {
                        "op": "pack_remove",
                        "index": "{pack.index}"
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "tag": "span",
                        "i18n": "profiles.remove_pack"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "type": "stack",
      "when": "profiles.pin",
      "children": [
        {
          "type": "column",
          "class": "menu-scrim fill-space",
          "action": {
            "name": "profiles",
            "args": {
              "op": "pin_cancel"
            }
          }
        },
        {
          "type": "column",
          "children": [
            {
              "type": "column",
              "class": "popover menu-panel panel-box",
              "width": "{const.dialogWidth}",
              "children": [
                {
                  "type": "row",
                  "tag": "header",
                  "children": [
                    {
                      "include": "avatar",
                      "with": {
                        "image": "profiles.pin.avatar",
                        "name": "profiles.pin.name",
                        "size": "36",
                        "badge": "\"\"",
                        "ring": "-1"
                      }
                    },
                    {
                      "type": "text",
                      "tag": "h4",
                      "text": "{profiles.pin.name}"
                    }
                  ]
                },
                {
                  "type": "text",
                  "tag": "small",
                  "i18n": "profiles.pin_prompt"
                },
                {
                  "type": "input",
                  "props": {
                    "key": "profileUnlock",
                    "placeholder": "{profiles.pin.hint}",
                    "value": "{fields.profileUnlock}",
                    "kind": "password"
                  },
                  "width": "{const.dialogInput}"
                },
                {
                  "type": "text",
                  "when": "profiles.pin.error",
                  "text": "{profiles.pin.error}",
                  "style": "meta"
                },
                {
                  "type": "row",
                  "tag": "footer",
                  "class": "split",
                  "children": [
                    {
                      "type": "row",
                      "tag": "button",
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "pin_cancel"
                        }
                      },
                      "children": [
                        {
                          "type": "text",
                          "tag": "span",
                          "i18n": "common.cancel"
                        }
                      ]
                    },
                    {
                      "type": "row",
                      "tag": "button",
                      "class": "primary",
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "pin_unlock"
                        }
                      },
                      "children": [
                        {
                          "type": "text",
                          "tag": "span",
                          "i18n": "profiles.unlock"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "class": "fullscreen centered fullscreen-center"
        }
      ],
      "class": "fullscreen"
    },
    {
      "type": "stack",
      "when": "profiles.confirm",
      "children": [
        {
          "type": "column",
          "class": "menu-scrim fill-space",
          "action": {
            "name": "profiles",
            "args": {
              "op": "confirm_cancel"
            }
          }
        },
        {
          "type": "column",
          "children": [
            {
              "type": "column",
              "class": "popover menu-panel panel-box",
              "width": "{const.dialogWidth}",
              "children": [
                {
                  "type": "text",
                  "tag": "h4",
                  "i18n": "profiles.delete_confirm_title"
                },
                {
                  "type": "text",
                  "tag": "small",
                  "text": "{profiles.confirm.body}"
                },
                {
                  "type": "row",
                  "tag": "footer",
                  "class": "split",
                  "children": [
                    {
                      "type": "row",
                      "tag": "button",
                      "action": {
                        "name": "profiles",
                        "args": {
                          "op": "confirm_cancel"
                        }
                      },
                      "children": [
                        {
