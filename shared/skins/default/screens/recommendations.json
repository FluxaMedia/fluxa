{
  "type": "stack",
  "children": [
    {
      "type": "image",
      "src": "{recommendations.backdrop}",
      "when": "recommendations.backdrop",
      "props": {
        "fit": "cover"
      }
    },
    {
      "type": "column",
      "class": "scrim-bottom fill-space"
    },
    {
      "type": "column",
      "tag": "section",
      "class": "fullscreen copy",
      "children": [
        {
          "type": "column",
          "class": "reco-text",
          "children": [
            {
              "type": "image",
              "src": "{recommendations.logo}",
              "when": "recommendations.logo",
              "props": {
                "fit": "contain"
              },
              "class": "copy-logo"
            },
            {
              "type": "text",
              "tag": "h1",
              "text": "{recommendations.title}",
              "when": "!recommendations.logo"
            },
            {
              "type": "text",
              "tag": "small",
              "text": "{recommendations.eyebrow}",
              "when": "recommendations.eyebrow"
            },
            {
              "type": "text",
              "text": "{recommendations.description}",
              "class": "setting-hint",
              "when": "recommendations.description",
              "props": {
                "lines": 3
              }
            },
            {
              "type": "row",
              "tag": "ul",
              "class": "dots",
              "children": [
                {
                  "each": "recommendations.dots",
                  "as": "d",
                  "template": {
                    "type": "row",
                    "children": [
                      {
                        "type": "row",
                        "class": "chip-active",
                        "when": "d.active",
                        "action": {
                          "name": "node",
                          "args": {
                            "id": "{d.node}"
                          }
                        },
                        "children": []
                      },
                      {
                        "type": "row",
                        "class": "chip",
                        "when": "!d.active",
                        "action": {
                          "name": "node",
                          "args": {
                            "id": "{d.node}"
                          }
                        },
                        "children": []
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "row",
              "tag": "section",
              "class": "actions",
              "children": [
                {
                  "type": "row",
                  "tag": "button",
                  "class": "primary",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{recommendations.playNode}"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "text": "{recommendations.play}"
                    }
                  ]
                },
                {
                  "type": "row",
                  "tag": "button",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{recommendations.detailsNode}"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "tag": "span",
                      "text": "{recommendations.details}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "tag": "header",
      "children": [
        {
          "type": "row",
          "class": "icon-btn",
          "action": {
            "name": "node",
            "args": {
              "id": "{recommendations.closeNode}"
            }
          },
          "children": [
            {
              "type": "icon",
              "props": {
                "name": "Close",
                "size": 18
              }
            }
          ]
        }
      ]
    }
  ],
  "class": "fullscreen slider-chapter reco"
}
