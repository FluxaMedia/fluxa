{
  "type": "stack",
  "children": [
    {
      "type": "image",
      "src": "{recommendations.backdrop}",
      "when": "recommendations.backdrop",
      "props": {
        "fit": "cover"
      }
    },
    {
      "type": "column",
      "class": "scrim-bottom",
      "fill": true
    },
    {
      "type": "column",
      "children": [
        {
          "type": "column",
          "children": [
            {
              "type": "image",
              "src": "{recommendations.logo}",
              "when": "recommendations.logo",
              "props": {
                "fit": "contain"
              },
              "class": "h96"
            },
            {
              "type": "text",
              "text": "{recommendations.title}",
              "style": "title",
              "when": "!recommendations.logo"
            },
            {
              "type": "text",
              "text": "{recommendations.eyebrow}",
              "style": "meta muted",
              "when": "recommendations.eyebrow"
            },
            {
              "type": "text",
              "text": "{recommendations.description}",
              "class": "setting-hint",
              "when": "recommendations.description",
              "props": {
                "lines": 3
              }
            },
            {
              "type": "row",
              "children": [
                {
                  "each": "recommendations.dots",
                  "as": "d",
                  "template": {
                    "type": "row",
                    "children": [
                      {
                        "type": "row",
                        "class": "chip-active w10-h10",
                        "when": "d.active",
                        "action": {
                          "name": "node",
                          "args": {
                            "id": "{d.node}"
                          }
                        },
                        "children": []
                      },
                      {
                        "type": "row",
                        "class": "chip w10-h10",
                        "when": "!d.active",
                        "action": {
                          "name": "node",
                          "args": {
                            "id": "{d.node}"
                          }
                        },
                        "children": []
                      }
                    ]
                  }
                }
              ],
              "class": "gap6-items-center"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "btn-primary h44-pad0-24-justify-center",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{recommendations.playNode}"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{recommendations.play}"
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "btn-secondary h44-pad0-24-justify-center",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{recommendations.detailsNode}"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{recommendations.details}"
                    }
                  ]
                }
              ],
              "class": "gap12"
            }
          ],
          "class": "w560-gap12-items-start"
        }
      ],
      "class": "w100vw-h100vh-pad0-64-56-64-items-end-justify-end"
    },
    {
      "type": "row",
      "children": [
        {
          "type": "row",
          "class": "icon-btn",
          "action": {
            "name": "node",
            "args": {
              "id": "{recommendations.closeNode}"
            }
          },
          "children": [
            {
              "type": "icon",
              "props": {
                "name": "Close",
                "size": 18
              }
            }
          ]
        }
      ],
      "class": "w100vw-h64-gap0-pad24-24-0-24-items-start-justify-end"
    }
  ],
  "class": "player-black"
}
