{
  "type": "column",
  "class": "screen screen-browse",
  "children": [
    {
      "type": "spacer",
      "class": "top-inset"
    },
    {
      "type": "page",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "row",
              "class": "centered icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "ArrowLeft"
                  }
                }
              ],
              "action": {
                "name": "folder",
                "args": {
                  "op": "back"
                }
              }
            },
            {
              "type": "image",
              "src": "{folder.cover}",
              "when": "folder.cover",
              "props": {
                "fit": "cover"
              },
              "class": "folder-logo"
            },
            {
              "type": "text",
              "text": "{folder.title}",
              "style": "title"
            }
          ],
          "class": "card-head"
        },
        {
          "type": "scroll",
          "when": "folder.showTabs",
          "children": [
            {
              "each": "folder.tabs",
              "as": "chip",
              "template": {
                "type": "row",
                "children": [
                  {
                    "include": "folder_tab_active",
                    "when": "chip.selected"
                  },
                  {
                    "include": "folder_tab",
                    "when": "!chip.selected"
                  }
                ]
              }
            }
          ],
          "class": "folder-tabs"
        },
        {
          "type": "text",
          "text": "{folder.error}",
          "style": "meta muted",
          "when": "folder.error"
        },
        {
          "type": "text",
          "i18n": "discover.no_content",
          "style": "meta muted",
          "when": "folder.empty"
        }
      ],
      "class": "page-dense"
    },
    {
      "type": "grid",
      "class": "poster-grid",
      "when": "folder.grid",
      "children": [
        {
          "each": "folder.cards",
          "as": "card",
          "template": {
            "include": "card"
          }
        }
      ]
    },
    {
      "type": "column",
      "when": "!folder.grid",
      "children": [
        {
          "each": "folder.rows",
          "as": "row",
          "template": {
            "include": "shelf"
          }
        }
      ],
      "class": "folder-shelves"
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "compact-only nav-dock"
        }
      ]
    }
  ]
}
