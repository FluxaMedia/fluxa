{
  "type": "column",
  "class": "screen gap16-items-stretch",
  "children": [
    {
      "type": "spacer",
      "class": "spacer-h72"
    },
    {
      "type": "page",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "ArrowLeft"
                  }
                }
              ],
              "action": {
                "name": "folder",
                "args": {
                  "op": "back"
                }
              }
            },
            {
              "type": "image",
              "src": "{folder.cover}",
              "when": "folder.cover",
              "props": {
                "fit": "cover"
              },
              "class": "w56-h56"
            },
            {
              "type": "text",
              "text": "{folder.title}",
              "style": "title"
            }
          ],
          "class": "gap14-items-center"
        },
        {
          "type": "scroll",
          "when": "folder.showTabs",
          "children": [
            {
              "each": "folder.tabs",
              "as": "chip",
              "template": {
                "type": "row",
                "children": [
                  {
                    "include": "folder_tab_active",
                    "when": "chip.selected"
                  },
                  {
                    "include": "folder_tab",
                    "when": "!chip.selected"
                  }
                ]
              }
            }
          ],
          "class": "gap8"
        },
        {
          "type": "text",
          "text": "{folder.error}",
          "style": "meta muted",
          "when": "folder.error"
        },
        {
          "type": "text",
          "i18n": "discover.no_content",
          "style": "meta muted",
          "when": "folder.empty"
        }
      ],
      "class": "gap14"
    },
    {
      "type": "grid",
      "when": "folder.grid",
      "children": [
        {
          "each": "folder.cards",
          "as": "card",
          "template": {
            "include": "card"
          }
        }
      ]
    },
    {
      "type": "column",
      "when": "!folder.grid",
      "children": [
        {
          "each": "folder.rows",
          "as": "row",
          "template": {
            "include": "shelf"
          }
        }
      ],
      "class": "gap16"
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "form": [
            "desktop",
            "tv"
          ]
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "column-w100vw-h100vh-pad0-0-16-0-items-center-justify-end only-mobile"
        }
      ]
    }
  ]
}
