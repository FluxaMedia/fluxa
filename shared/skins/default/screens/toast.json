{
  "type": "stack",
  "children": [
    {
      "type": "column",
      "tag": "section",
      "class": "fullscreen toast-top",
      "children": [
        {
          "type": "row",
          "class": "toast",
          "children": [
            {
              "type": "text",
              "text": "{toast.text}",
              "style": "meta",
              "props": {
                "lines": 2
              }
            }
          ]
        }
      ],
      "when": "!toast.gauge"
    },
    {
      "type": "row",
      "tag": "section",
      "class": "fullscreen toast-gauge",
      "when": "toast.gauge",
      "children": [
        {
          "type": "row",
          "when": "toast.right",
          "class": "fill-space"
        },
        {
          "type": "icon",
          "props": {
            "name": "{toast.icon}",
            "size": 28
          }
        },
        {
          "type": "column",
          "class": "gauge-track",
          "children": [
            {
              "type": "column",
              "class": "gauge-fill",
              "height": "{toast.fill}"
            }
          ]
        },
        {
          "type": "row",
          "when": "toast.left",
          "class": "fill-space"
        }
      ]
    }
  ],
  "class": "fullscreen"
}
