{
  "type": "stack",
  "children": [
    {
      "type": "column",
      "children": [
        {
          "type": "row",
          "class": "toast pad10-16-10-16-items-center",
          "children": [
            {
              "type": "text",
              "text": "{toast.text}",
              "style": "meta",
              "props": {
                "lines": 2
              }
            }
          ]
        }
      ],
      "when": "!toast.gauge",
      "class": "w100vw-h100vh-pad48-0-0-0-items-center"
    },
    {
      "type": "row",
      "when": "toast.gauge",
      "children": [
        {
          "type": "row",
          "when": "toast.right",
          "fill": true
        },
        {
          "type": "icon",
          "props": {
            "name": "{toast.icon}",
            "size": 28
          }
        },
        {
          "type": "column",
          "class": "gauge-track",
          "children": [
            {
              "type": "column",
              "class": "gauge-fill",
              "height": "{toast.fill}"
            }
          ]
        },
        {
          "type": "row",
          "when": "toast.left",
          "fill": true
        }
      ],
      "class": "w100vw-h100vh-gap14-pad0-24-0-24-items-center"
    }
  ],
  "class": "stack-w100vw-h100vh"
}
