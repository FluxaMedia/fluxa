{
  "type": "column",
  "class": "screen",
  "gap": 16,
  "children": [
    {
      "type": "spacer",
      "height": 72
    },
    {
      "type": "page",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "i18n": "nav.discover",
              "style": "title"
            },
            {
              "type": "input",
              "props": {
                "key": "discoverSearch",
                "placeholder": "Search",
                "value": "{fields.discoverSearch}",
                "kind": "search"
              },
              "class": "wide-only search-field"
            }
          ],
          "justify": "space_between"
        },
        {
          "type": "input",
          "props": {
            "key": "discoverSearch",
            "placeholder": "Search",
            "value": "{fields.discoverSearch}",
            "kind": "search"
          },
          "class": "compact-only"
        },
        {
          "type": "row",
          "children": [
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"discover:contentType\"",
                "value": "discover.contentType",
                "options": "discover.typeOptions",
                "width": "160"
              }
            },
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"discover:catalog\"",
                "value": "discover.catalog",
                "options": "discover.catalogOptions",
                "width": "240"
              },
              "when": "len(discover.catalogOptions) > 0"
            },
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"discover:extra\"",
                "value": "discover.extra",
                "options": "discover.extraOptions",
                "width": "200"
              },
              "when": "discover.hasExtra"
            }
          ],
          "gap": 10
        },
        {
          "include": "empty_state",
          "with": {
            "icon": "\"Discover\"",
            "title": "\"discover.no_content\"",
            "hint": "\"discover.install_addons_hint\""
          },
          "when": "len(discover.results) == 0"
        }
      ],
      "class": "page-snug"
    },
    {
      "type": "grid",
      "class": "poster-grid",
      "props": {
        "more": "{discover.nextPage}"
      },
      "children": [
        {
          "each": "discover.results",
          "limit": 100000,
          "window": true,
          "as": "card",
          "template": {
            "include": "card"
          }
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "compact-only nav-dock"
        }
      ]
    }
  ]
}
