{
  "type": "column",
  "class": "screen",
  "gap": 16,
  "align": "stretch",
  "children": [
    {
      "type": "spacer",
      "class": "spacer-h72"
    },
    {
      "type": "page",
      "gap": 12,
      "children": [
        {
          "type": "row",
          "align": "center",
          "justify": "space_between",
          "children": [
            {
              "type": "text",
              "i18n": "nav.discover",
              "style": "title"
            },
            {
              "type": "input",
              "width": 320,
              "props": {
                "key": "discoverSearch",
                "placeholder": "Search",
                "value": "{fields.discoverSearch}",
                "kind": "search"
              },
              "form": [
                "desktop",
                "tv"
              ]
            }
          ]
        },
        {
          "type": "input",
          "form": [
            "mobile"
          ],
          "props": {
            "key": "discoverSearch",
            "placeholder": "Search",
            "value": "{fields.discoverSearch}",
            "kind": "search"
          }
        },
        {
          "type": "row",
          "children": [
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"discover:contentType\"",
                "value": "discover.contentType",
                "options": "discover.typeOptions",
                "width": "160"
              }
            },
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"discover:catalog\"",
                "value": "discover.catalog",
                "options": "discover.catalogOptions",
                "width": "240"
              },
              "when": "len(discover.catalogOptions) > 0"
            },
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"discover:extra\"",
                "value": "discover.extra",
                "options": "discover.extraOptions",
                "width": "200"
              },
              "when": "discover.hasExtra"
            }
          ],
          "class": "row-gap10-items-center"
        },
        {
          "include": "empty_state",
          "with": {
            "icon": "\"Discover\"",
            "title": "\"discover.no_content\"",
            "hint": "\"discover.install_addons_hint\""
          },
          "when": "len(discover.results) == 0"
        }
      ]
    },
    {
      "type": "grid",
      "props": {
        "more": "{discover.nextPage}"
      },
      "children": [
        {
          "each": "discover.results",
          "limit": 100000,
          "window": true,
          "as": "card",
          "template": {
            "include": "card"
          }
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "form": [
            "desktop",
            "tv"
          ]
        },
        {
          "type": "column",
          "form": [
            "mobile"
          ],
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "column-w100vw-h100vh-pad0-0-16-0-items-center-justify-end"
        }
      ]
    }
  ]
}
