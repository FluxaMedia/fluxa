{
  "type": "stack",
  "children": [
    {
      "type": "column",
      "class": "menu-scrim fill-space",
      "action": {
        "name": "node",
        "args": {
          "id": "{dialog.cancelNode}"
        }
      }
    },
    {
      "type": "column",
      "children": [
        {
          "type": "column",
          "class": "menu-panel gap-12 pad-20 items-stretch",
          "width": "{const.dialogWidth}",
          "when": "dialog.kind == \"report\"",
          "children": [
            {
              "type": "text",
              "text": "{dialog.title}",
              "style": "subtitle"
            },
            {
              "type": "text",
              "text": "{dialog.description}",
              "props": {
                "lines": 3
              },
              "class": "setting-hint"
            },
            {
              "type": "input",
              "props": {
                "key": "reportTitle",
                "placeholder": "{dialog.titleHint}",
                "value": "{dialog.titleValue}",
                "kind": "text"
              },
              "class": "w-380"
            },
            {
              "type": "input",
              "props": {
                "key": "reportBody",
                "placeholder": "{dialog.bodyHint}",
                "value": "{dialog.bodyValue}",
                "kind": "text"
              },
              "class": "w-380"
            },
            {
              "type": "text",
              "text": "{dialog.counter}",
              "style": "meta muted"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "btn-secondary h-40 justify-center grow",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{dialog.cancelNode}",
                      "fill": ""
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{dialog.cancel}"
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "btn-primary h-40 justify-center grow",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{dialog.sendNode}",
                      "fill": "{dialog.fill}"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{dialog.send}"
                    }
                  ],
                  "when": "dialog.ready"
                },
                {
                  "type": "row",
                  "class": "btn-secondary h-40 justify-center grow",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{dialog.cancelNode}",
                      "fill": ""
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{dialog.send}"
                    }
                  ],
                  "when": "!dialog.ready"
                }
              ],
              "class": "gap-8"
            }
          ]
        },
        {
          "type": "column",
          "class": "menu-panel gap-12 pad-20 items-stretch",
          "width": "{const.dialogWidth}",
          "when": "dialog.kind == \"addon\"",
          "children": [
            {
              "type": "text",
              "text": "{dialog.title}",
              "style": "subtitle"
            },
            {
              "type": "text",
              "text": "{dialog.urlLabel}",
              "style": "meta muted"
            },
            {
              "type": "text",
              "text": "{dialog.url}",
              "style": "body"
            },
            {
              "type": "text",
              "text": "{dialog.nameLabel}",
              "style": "meta muted"
            },
            {
              "type": "input",
              "props": {
                "key": "addonName",
                "placeholder": "{dialog.nameHint}",
                "value": "{dialog.nameValue}",
                "kind": "text"
              },
              "class": "w-380"
            },
            {
              "type": "text",
              "text": "{dialog.hint}",
              "props": {
                "lines": 3
              },
              "class": "setting-hint"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "row",
                  "class": "btn-secondary h-40 justify-center grow",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{dialog.cancelNode}",
                      "fill": ""
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{dialog.cancel}"
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "btn-primary h-40 justify-center grow",
                  "action": {
                    "name": "node",
                    "args": {
                      "id": "{dialog.saveNode}",
                      "fill": "{dialog.fill}"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "class": "btn-label",
                      "text": "{dialog.save}"
                    }
                  ]
                }
              ],
              "class": "gap-8"
            }
          ]
        }
      ],
      "class": "w-100vw h-100vh items-center justify-center"
    }
  ],
  "class": "w-100vw h-100vh"
}
