{
  "type": "fixed",
  "children": [
    {
      "type": "stack",
      "children": [
        {
          "type": "column",
          "class": "modal-scrim fill-space",
          "action": {
            "name": "modal",
            "args": {
              "op": "close"
            }
          }
        },
        {
          "type": "column",
          "children": [
            {
              "type": "column",
              "class": "popover menu-panel",
              "height": "88vh",
              "width": "{const.modalWidth}",
              "children": [
                {
                  "type": "scroll",
                  "props": {
                    "axis": "y"
                  },
                  "children": [
                    {
                      "type": "column",
                      "children": [
                        {
                          "type": "stack",
                          "children": [
                            {
                              "type": "image",
                              "src": "{detail.backdrop}",
                              "props": {
                                "fit": "cover",
                                "focus": 0.2
                              }
                            },
                            {
                              "type": "column",
                              "class": "modal-hero-scrim fill-space"
                            },
                            {
                              "type": "column",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "{detail.title}",
                                  "style": "title"
                                },
                                {
                                  "type": "text",
                                  "text": "{detail.meta}",
                                  "style": "meta muted"
                                }
                              ],
                              "class": "fill-space",
                              "align": "start",
                              "justify": "end",
                              "gap": 8,
                              "padding": 20
                            }
                          ],
                          "height": 300
                        },
                        {
                          "type": "column",
                          "children": [
                            {
                              "type": "row",
                              "children": [
                                {
                                  "type": "row",
                                  "class": "btn-primary",
                                  "height": 44,
                                  "padding": "0 20",
                                  "justify": "center",
                                  "gap": 8,
                                  "action": {
                                    "name": "modal",
                                    "args": {
                                      "op": "play"
                                    }
                                  },
                                  "children": [
                                    {
                                      "type": "icon",
                                      "class": "btn-label",
                                      "props": {
                                        "name": "PlayFilled",
                                        "size": 16
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "class": "btn-label",
                                      "text": "{detail.playLabel}"
                                    }
                                  ]
                                },
                                {
                                  "type": "row",
                                  "class": "centered icon-btn",
                                  "action": {
                                    "name": "modal",
                                    "args": {
                                      "op": "watchlist"
                                    }
                                  },
                                  "children": [
                                    {
                                      "type": "icon",
                                      "props": {
                                        "name": "{detail.watchlistIcon}"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "type": "row",
                                  "class": "centered icon-btn",
                                  "action": {
                                    "name": "modal",
                                    "args": {
                                      "op": "page"
                                    }
                                  },
                                  "children": [
                                    {
                                      "type": "icon",
                                      "props": {
                                        "name": "Info"
                                      }
                                    }
                                  ]
                                }
                              ],
                              "gap": 10
                            },
                            {
                              "type": "text",
                              "class": "synopsis",
                              "text": "{detail.description}",
                              "props": {
                                "lines": 8
                              }
                            },
                            {
                              "type": "column",
                              "when": "detail.show.episodes",
                              "children": [
                                {
                                  "type": "text",
                                  "style": "title section",
                                  "text": "{detail.titles.episodes}"
                                },
                                {
                                  "type": "row",
                                  "when": "detail.multiSeason",
                                  "children": [
                                    {
                                      "each": "detail.seasons",
                                      "as": "chip",
                                      "template": {
                                        "type": "row",
                                        "children": [
                                          {
                                            "include": "chip_active",
                                            "when": "chip.selected"
                                          },
                                          {
                                            "include": "chip",
                                            "when": "!chip.selected"
                                          }
                                        ]
                                      }
                                    }
                                  ],
                                  "gap": 8,
                                  "align": "center"
                                },
                                {
                                  "type": "column",
                                  "children": [
                                    {
                                      "each": "detail.episodes",
                                      "as": "ep",
                                      "template": {
                                        "type": "row",
                                        "class": "panel-row",
                                        "gap": 12,
                                        "action": {
                                          "name": "modal",
                                          "args": {
                                            "op": "episode",
                                            "index": "{ep.index}"
                                          }
                                        },
                                        "children": [
                                          {
                                            "type": "image",
                                            "src": "{ep.thumb}",
                                            "props": {
                                              "fit": "cover"
                                            },
                                            "class": "modal-thumb"
                                          },
                                          {
                                            "type": "column",
                                            "children": [
                                              {
                                                "type": "text",
                                                "text": "{ep.label}",
                                                "style": "meta muted"
                                              },
                                              {
                                                "type": "text",
                                                "text": "{ep.title}",
                                                "style": "subtitle",
                                                "class": "episode-title",
                                                "props": {
                                                  "lines": 1
                                                }
                                              },
                                              {
                                                "type": "text",
                                                "text": "{ep.overview}",
                                                "class": "synopsis episode-overview",
                                                "props": {
                                                  "lines": 2
                                                }
                                              }
                                            ],
                                            "gap": 2,
                                            "grow": 1
                                          }
                                        ]
                                      }
                                    }
                                  ],
                                  "gap": 8
                                }
                              ],
                              "class": "section"
                            },
                            {
                              "type": "column",
                              "when": "detail.show.similar",
                              "children": [
                                {
                                  "type": "text",
                                  "style": "title section",
                                  "text": "{detail.titles.similar}"
                                },
                                {
                                  "type": "scroll",
                                  "children": [
                                    {
                                      "each": "detail.similar",
                                      "as": "s",
                                      "template": {
                                        "type": "column",
                                        "action": {
                                          "name": "modal",
                                          "args": {
                                            "op": "similar",
                                            "index": "{index}"
                                          }
                                        },
                                        "children": [
                                          {
                                            "type": "image",
                                            "src": "{s.artworkUrl}",
                                            "props": {
                                              "fit": "cover"
                                            },
                                            "class": "modal-cast-photo"
                                          },
                                          {
                                            "type": "text",
                                            "text": "{s.title}",
                                            "style": "meta",
                                            "props": {
                                              "lines": 1
                                            }
                                          }
                                        ],
                                        "width": 140,
                                        "gap": 6
                                      }
                                    }
                                  ],
                                  "class": "thumb-strip"
                                }
                              ],
                              "class": "section"
                            }
                          ],
                          "gap": 16,
                          "padding": "0 20 20 20"
                        }
                      ],
                      "gap": 16
                    }
                  ],
                  "class": "modal-scroll"
                }
              ]
            }
          ],
          "class": "fullscreen centered fullscreen-center"
        }
      ],
      "class": "fullscreen"
    }
  ]
}
