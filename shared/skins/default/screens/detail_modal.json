{
  "type": "fixed",
  "children": [
    {
      "type": "stack",
      "children": [
        {
          "type": "column",
          "class": "modal-scrim fill-space",
          "action": {
            "name": "modal",
            "args": {
              "op": "close"
            }
          }
        },
        {
          "type": "column",
          "children": [
            {
              "type": "column",
              "class": "menu-panel h-88vh",
              "width": "{const.modalWidth}",
              "children": [
                {
                  "type": "scroll",
                  "props": {
                    "axis": "y"
                  },
                  "children": [
                    {
                      "type": "column",
                      "children": [
                        {
                          "type": "stack",
                          "children": [
                            {
                              "type": "image",
                              "src": "{detail.backdrop}",
                              "props": {
                                "fit": "cover",
                                "focus": 0.2
                              }
                            },
                            {
                              "type": "column",
                              "class": "modal-hero-scrim fill-space"
                            },
                            {
                              "type": "column",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "{detail.title}",
                                  "style": "title"
                                },
                                {
                                  "type": "text",
                                  "text": "{detail.meta}",
                                  "style": "meta muted"
                                }
                              ],
                              "class": "gap-8 pad-20 items-start justify-end fill-space"
                            }
                          ],
                          "class": "h-300"
                        },
                        {
                          "type": "column",
                          "children": [
                            {
                              "type": "row",
                              "children": [
                                {
                                  "type": "row",
                                  "class": "btn-primary h-44 gap-8 pad-0-20 justify-center",
                                  "action": {
                                    "name": "modal",
                                    "args": {
                                      "op": "play"
                                    }
                                  },
                                  "children": [
                                    {
                                      "type": "icon",
                                      "class": "btn-label",
                                      "props": {
                                        "name": "PlayFilled",
                                        "size": 16
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "class": "btn-label",
                                      "text": "{detail.playLabel}"
                                    }
                                  ]
                                },
                                {
                                  "type": "row",
                                  "class": "icon-btn",
                                  "action": {
                                    "name": "modal",
                                    "args": {
                                      "op": "watchlist"
                                    }
                                  },
                                  "children": [
                                    {
                                      "type": "icon",
                                      "props": {
                                        "name": "{detail.watchlistIcon}"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "type": "row",
                                  "class": "icon-btn",
                                  "action": {
                                    "name": "modal",
                                    "args": {
                                      "op": "page"
                                    }
                                  },
                                  "children": [
                                    {
                                      "type": "icon",
                                      "props": {
                                        "name": "Info"
                                      }
                                    }
                                  ]
                                }
                              ],
                              "class": "gap-10 items-center"
                            },
                            {
                              "type": "text",
                              "class": "synopsis",
                              "text": "{detail.description}",
                              "props": {
                                "lines": 8
                              }
                            },
                            {
                              "type": "column",
                              "when": "detail.show.episodes",
                              "children": [
                                {
                                  "type": "text",
                                  "style": "title section",
                                  "text": "{detail.titles.episodes}"
                                },
                                {
                                  "type": "row",
                                  "when": "detail.multiSeason",
                                  "children": [
                                    {
                                      "each": "detail.seasons",
                                      "as": "chip",
                                      "template": {
                                        "type": "row",
                                        "children": [
                                          {
                                            "include": "chip_active",
                                            "when": "chip.selected"
                                          },
                                          {
                                            "include": "chip",
                                            "when": "!chip.selected"
                                          }
                                        ]
                                      }
                                    }
                                  ],
                                  "class": "gap-8"
                                },
                                {
                                  "type": "column",
                                  "children": [
                                    {
                                      "each": "detail.episodes",
                                      "as": "ep",
                                      "template": {
                                        "type": "row",
                                        "class": "panel-row gap-12",
                                        "action": {
                                          "name": "modal",
                                          "args": {
                                            "op": "episode",
                                            "index": "{ep.index}"
                                          }
                                        },
                                        "children": [
                                          {
                                            "type": "image",
                                            "src": "{ep.thumb}",
                                            "props": {
                                              "fit": "cover"
                                            },
                                            "class": "w-160 h-90"
                                          },
                                          {
                                            "type": "column",
                                            "children": [
                                              {
                                                "type": "text",
                                                "text": "{ep.label}",
                                                "style": "meta muted"
                                              },
                                              {
                                                "type": "text",
                                                "text": "{ep.title}",
                                                "style": "subtitle",
                                                "class": "episode-title",
                                                "props": {
                                                  "lines": 1
                                                }
                                              },
                                              {
                                                "type": "text",
                                                "text": "{ep.overview}",
                                                "class": "synopsis episode-overview",
                                                "props": {
                                                  "lines": 2
                                                }
                                              }
                                            ],
                                            "class": "gap-2 grow"
                                          }
                                        ]
                                      }
                                    }
                                  ],
                                  "class": "gap-8 items-stretch"
                                }
                              ],
                              "class": "gap-10"
                            },
                            {
                              "type": "column",
                              "when": "detail.show.similar",
                              "children": [
                                {
                                  "type": "text",
                                  "style": "title section",
                                  "text": "{detail.titles.similar}"
                                },
                                {
                                  "type": "scroll",
                                  "children": [
                                    {
                                      "each": "detail.similar",
                                      "as": "s",
                                      "template": {
                                        "type": "column",
                                        "action": {
                                          "name": "modal",
                                          "args": {
                                            "op": "similar",
                                            "index": "{index}"
                                          }
                                        },
                                        "children": [
                                          {
                                            "type": "image",
                                            "src": "{s.artworkUrl}",
                                            "props": {
                                              "fit": "cover"
                                            },
                                            "class": "w-140 h-210"
                                          },
                                          {
                                            "type": "text",
                                            "text": "{s.title}",
                                            "style": "meta",
                                            "props": {
                                              "lines": 1
                                            }
                                          }
                                        ],
                                        "class": "w-140 gap-6"
                                      }
                                    }
                                  ],
                                  "class": "gap-12"
                                }
                              ],
                              "class": "gap-10"
                            }
                          ],
                          "class": "gap-16 pad-0-20-20-20 items-stretch"
                        }
                      ],
                      "class": "gap-16 items-stretch"
                    }
                  ],
                  "class": "grow"
                }
              ]
            }
          ],
          "class": "w-100vw h-100vh items-center justify-center"
        }
      ],
      "class": "w-100vw h-100vh"
    }
  ]
}
