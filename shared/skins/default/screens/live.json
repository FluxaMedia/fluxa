{
  "type": "column",
  "class": "screen gap14-items-stretch",
  "children": [
    {
      "type": "spacer",
      "class": "spacer-h72"
    },
    {
      "type": "page",
      "children": [
        {
          "type": "text",
          "text": "{guide.title}",
          "style": "title"
        },
        {
          "type": "text",
          "i18n": "guide.loading",
          "style": "meta muted",
          "when": "guide.loading"
        },
        {
          "type": "text",
          "i18n": "guide.empty",
          "style": "meta muted",
          "when": "guide.empty"
        }
      ],
      "class": "gap14"
    },
    {
      "type": "scroll",
      "children": [
        {
          "type": "stack",
          "children": [
            {
              "type": "column",
              "children": [
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "spacer",
                      "width": "{guide.labelWidth}"
                    },
                    {
                      "each": "guide.hours",
                      "as": "hour",
                      "template": {
                        "type": "text",
                        "text": "{hour.label}",
                        "style": "meta muted",
                        "width": "{hour.width}"
                      }
                    }
                  ],
                  "class": "gap0"
                },
                {
                  "each": "guide.channels",
                  "as": "channel",
                  "template": {
                    "type": "row",
                    "children": [
                      {
                        "type": "text",
                        "text": "{channel.name}",
                        "style": "subtitle",
                        "width": "{guide.labelWidth}",
                        "props": {
                          "lines": 1
                        },
                        "class": "guide-channel"
                      },
                      {
                        "type": "image",
                        "src": "{channel.logo}",
                        "when": "channel.logo",
                        "props": {
                          "fit": "contain"
                        },
                        "class": "w40-h40"
                      },
                      {
                        "each": "channel.cells",
                        "as": "cell",
                        "template": {
                          "type": "row",
                          "width": "{cell.width}",
                          "children": [
                            {
                              "type": "column",
                              "class": "{cell.class} h64-gap2-pad10",
                              "when": "!cell.blank",
                              "action": {
                                "name": "guide",
                                "args": {
                                  "node": "{cell.node}"
                                }
                              },
                              "children": [
                                {
                                  "type": "text",
                                  "text": "{cell.title}",
                                  "style": "subtitle"
                                },
                                {
                                  "type": "text",
                                  "text": "{cell.time}",
                                  "style": "meta muted"
                                }
                              ],
                              "fill": true
                            }
                          ],
                          "class": "h64-gap0"
                        }
                      }
                    ],
                    "class": "row-gap4-items-center"
                  }
                }
              ],
              "class": "gap6"
            },
            {
              "type": "row",
              "padding": "0 0 0 {guide.nowX}",
              "children": [
                {
                  "type": "spacer",
                  "width": "{guide.labelWidth}"
                },
                {
                  "type": "column",
                  "class": "guide-now"
                }
              ]
            }
          ],
          "class": "pad0-0-0-48"
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "form": [
            "desktop",
            "tv"
          ]
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "column-w100vw-h100vh-pad0-0-16-0-items-center-justify-end only-mobile"
        }
      ]
    }
  ]
}
