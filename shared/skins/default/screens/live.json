{
  "type": "column",
  "class": "screen library",
  "children": [
    {
      "type": "spacer",
      "class": "lead"
    },
    {
      "type": "page",
      "children": [
        {
          "type": "text",
          "tag": "h1",
          "text": "{guide.title}"
        },
        {
          "type": "text",
          "tag": "small",
          "i18n": "guide.loading",
          "when": "guide.loading"
        },
        {
          "type": "text",
          "tag": "small",
          "i18n": "guide.empty",
          "when": "guide.empty"
        }
      ],
      "class": "page-dense listing"
    },
    {
      "type": "scroll",
      "children": [
        {
          "type": "stack",
          "tag": "section",
          "class": "guide",
          "children": [
            {
              "type": "column",
              "tag": "section",
              "class": "channels",
              "children": [
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "spacer",
                      "width": "{guide.labelWidth}"
                    },
                    {
                      "each": "guide.hours",
                      "as": "hour",
                      "template": {
                        "type": "text",
                        "tag": "small",
                        "text": "{hour.label}",
                        "width": "{hour.width}"
                      }
                    }
                  ]
                },
                {
                  "each": "guide.channels",
                  "as": "channel",
                  "template": {
                    "type": "row",
                    "tag": "li",
                    "children": [
                      {
                        "type": "text",
                        "tag": "h4",
                        "class": "guide-channel",
                        "text": "{channel.name}",
                        "width": "{guide.labelWidth}",
                        "props": {
                          "lines": 1
                        }
                      },
                      {
                        "type": "image",
                        "src": "{channel.logo}",
                        "when": "channel.logo",
                        "props": {
                          "fit": "contain"
                        },
                        "class": "channel-logo"
                      },
                      {
                        "each": "channel.cells",
                        "as": "cell",
                        "template": {
                          "type": "row",
                          "width": "{cell.width}",
                          "children": [
                            {
                              "type": "column",
                              "class": "{cell.class} fill-space program",
                              "when": "!cell.blank",
                              "action": {
                                "name": "guide",
                                "args": {
                                  "node": "{cell.node}"
                                }
                              },
                              "children": [
                                {
                                  "type": "text",
                                  "tag": "h4",
                                  "text": "{cell.title}"
                                },
                                {
                                  "type": "text",
                                  "tag": "small",
                                  "text": "{cell.time}"
                                }
                              ]
                            }
                          ],
                          "class": "slot"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "row",
              "padding": "0 0 0 {guide.nowX}",
              "children": [
                {
                  "type": "spacer",
                  "width": "{guide.labelWidth}"
                },
                {
                  "type": "column",
                  "class": "guide-now"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "compact-only nav-dock"
        }
      ]
    }
  ]
}
