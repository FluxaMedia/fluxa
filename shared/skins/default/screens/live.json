{
  "type": "column",
  "class": "screen",
  "gap": 14,
  "children": [
    {
      "type": "spacer",
      "height": 72
    },
    {
      "type": "page",
      "children": [
        {
          "type": "text",
          "text": "{guide.title}",
          "style": "title"
        },
        {
          "type": "text",
          "i18n": "guide.loading",
          "style": "meta muted",
          "when": "guide.loading"
        },
        {
          "type": "text",
          "i18n": "guide.empty",
          "style": "meta muted",
          "when": "guide.empty"
        }
      ],
      "class": "page-dense"
    },
    {
      "type": "scroll",
      "children": [
        {
          "type": "stack",
          "children": [
            {
              "type": "column",
              "children": [
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "spacer",
                      "width": "{guide.labelWidth}"
                    },
                    {
                      "each": "guide.hours",
                      "as": "hour",
                      "template": {
                        "type": "text",
                        "text": "{hour.label}",
                        "style": "meta muted",
                        "width": "{hour.width}"
                      }
                    }
                  ]
                },
                {
                  "each": "guide.channels",
                  "as": "channel",
                  "template": {
                    "type": "row",
                    "children": [
                      {
                        "type": "text",
                        "text": "{channel.name}",
                        "style": "subtitle",
                        "width": "{guide.labelWidth}",
                        "props": {
                          "lines": 1
                        },
                        "class": "guide-channel"
                      },
                      {
                        "type": "image",
                        "src": "{channel.logo}",
                        "when": "channel.logo",
                        "props": {
                          "fit": "contain"
                        },
                        "width": 40,
                        "height": 40
                      },
                      {
                        "each": "channel.cells",
                        "as": "cell",
                        "template": {
                          "type": "row",
                          "width": "{cell.width}",
                          "children": [
                            {
                              "type": "column",
                              "class": "{cell.class} h-64 gap-2 pad-10 fill-space",
                              "when": "!cell.blank",
                              "action": {
                                "name": "guide",
                                "args": {
                                  "node": "{cell.node}"
                                }
                              },
                              "children": [
                                {
                                  "type": "text",
                                  "text": "{cell.title}",
                                  "style": "subtitle"
                                },
                                {
                                  "type": "text",
                                  "text": "{cell.time}",
                                  "style": "meta muted"
                                }
                              ]
                            }
                          ],
                          "height": 64
                        }
                      }
                    ],
                    "gap": 4
                  }
                }
              ],
              "gap": 6
            },
            {
              "type": "row",
              "padding": "0 0 0 {guide.nowX}",
              "children": [
                {
                  "type": "spacer",
                  "width": "{guide.labelWidth}"
                },
                {
                  "type": "column",
                  "class": "guide-now",
                  "width": 2,
                  "height": "100vh"
                }
              ]
            }
          ],
          "padding": "0 0 0 48"
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "compact-only nav-dock"
        }
      ]
    }
  ]
}
