{
  "type": "column",
  "class": "screen",
  "gap": 14,
  "align": "stretch",
  "children": [
    {
      "type": "spacer",
      "height": 72
    },
    {
      "type": "page",
      "gap": 14,
      "children": [
        {
          "type": "text",
          "text": "{guide.title}",
          "style": "title"
        },
        {
          "type": "text",
          "i18n": "guide.loading",
          "style": "meta muted",
          "when": "guide.loading"
        },
        {
          "type": "text",
          "i18n": "guide.empty",
          "style": "meta muted",
          "when": "guide.empty"
        }
      ]
    },
    {
      "type": "scroll",
      "children": [
        {
          "type": "column",
          "gap": 6,
          "children": [
            {
              "type": "row",
              "gap": 0,
              "children": [
                {
                  "each": "guide.hours",
                  "as": "hour",
                  "template": {
                    "type": "text",
                    "text": "{hour.label}",
                    "style": "meta muted",
                    "width": "{hour.width}"
                  }
                }
              ]
            },
            {
              "each": "guide.channels",
              "as": "channel",
              "template": {
                "type": "row",
                "gap": 4,
                "align": "center",
                "children": [
                  {
                    "type": "image",
                    "src": "{channel.logo}",
                    "width": 40,
                    "height": 40,
                    "when": "channel.logo",
                    "props": {
                      "fit": "contain"
                    }
                  },
                  {
                    "each": "channel.cells",
                    "as": "cell",
                    "template": {
                      "type": "row",
                      "width": "{cell.width}",
                      "height": 64,
                      "gap": 0,
                      "children": [
                        {
                          "type": "column",
                          "class": "{cell.class}",
                          "when": "!cell.blank",
                          "height": 64,
                          "padding": 10,
                          "gap": 2,
                          "action": {
                            "name": "guide",
                            "args": {
                              "node": "{cell.node}"
                            }
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "{cell.title}",
                              "style": "subtitle"
                            },
                            {
                              "type": "text",
                              "text": "{cell.time}",
                              "style": "meta muted"
                            }
                          ],
                          "fill": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar"
        }
      ]
    }
  ]
}