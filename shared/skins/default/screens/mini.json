{
  "type": "fixed",
  "props": {
    "snap": "corners",
    "margin": "80 24 24 24",
    "corner": "bottom-right"
  },
  "children": [
    {
      "type": "stack",
      "class": "mini-tile",
      "action": {
        "name": "player",
        "args": {
          "op": "expand"
        }
      },
      "children": [
        {
          "type": "video",
          "props": {
            "source": "player",
            "radius": 8
          }
        },
        {
          "type": "column",
          "tag": "footer",
          "class": "fill-space",
          "children": [
            {
              "type": "row",
              "class": "mini-controls",
              "children": [
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "player",
                    "args": {
                      "op": "toggle"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "{mini.playIcon}"
                      }
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "player",
                    "args": {
                      "op": "expand"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "CornersOut"
                      }
                    }
                  ]
                },
                {
                  "type": "row",
                  "class": "icon-btn",
                  "action": {
                    "name": "player",
                    "args": {
                      "op": "close"
                    }
                  },
                  "children": [
                    {
                      "type": "icon",
                      "props": {
                        "name": "Close"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "class": "progress-track",
              "children": [
                {
                  "type": "column",
                  "class": "progress-bar",
                  "props": {
                    "span": "{mini.ratio}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
