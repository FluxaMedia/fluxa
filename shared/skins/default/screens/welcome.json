{
  "type": "column",
  "class": "screen fullscreen centered fullscreen-center",
  "children": [
    {
      "type": "column",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "icon",
              "props": {
                "logo": "wordmark",
                "size": 84
              }
            }
          ],
          "justify": "center"
        },
        {
          "type": "spacer",
          "height": 28
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "class": "welcome-title",
              "i18n": "auth.welcome_back"
            }
          ],
          "justify": "center"
        },
        {
          "type": "spacer",
          "height": 8
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.nuvio.subtitle",
              "props": {
                "lines": 2,
                "center": "true"
              }
            }
          ]
        },
        {
          "type": "spacer",
          "height": 28
        },
        {
          "type": "row",
          "class": "welcome-error",
          "padding": "12 16",
          "when": "welcome.error",
          "children": [
            {
              "type": "text",
              "class": "welcome-error-text",
              "text": "{welcome.error}",
              "props": {
                "lines": 3
              }
            }
          ]
        },
        {
          "type": "spacer",
          "when": "welcome.error",
          "height": 16
        },
        {
          "type": "text",
          "class": "welcome-label",
          "i18n": "auth.field.email"
        },
        {
          "type": "spacer",
          "height": 8
        },
        {
          "type": "input",
          "props": {
            "key": "welcomeEmail",
            "placeholder": "you@example.com",
            "value": "{fields.welcomeEmail}",
            "kind": "text"
          },
          "class": "fill-space"
        },
        {
          "type": "spacer",
          "height": 16
        },
        {
          "type": "text",
          "class": "welcome-label",
          "i18n": "auth.field.password"
        },
        {
          "type": "spacer",
          "height": 8
        },
        {
          "type": "input",
          "props": {
            "key": "welcomePassword",
            "placeholder": "",
            "value": "{fields.welcomePassword}",
            "kind": "password"
          },
          "class": "fill-space"
        },
        {
          "type": "spacer",
          "height": 24
        },
        {
          "type": "row",
          "class": "btn-primary",
          "padding": "0 28",
          "justify": "center",
          "when": "!welcome.busy",
          "action": {
            "name": "welcome",
            "args": {
              "op": "signin"
            }
          },
          "children": [
            {
              "type": "text",
              "class": "btn-label",
              "i18n": "auth.log_in"
            }
          ]
        },
        {
          "type": "row",
          "class": "btn-secondary",
          "padding": "0 28",
          "justify": "center",
          "gap": 10,
          "when": "welcome.busy",
          "children": [
            {
              "type": "icon",
              "props": {
                "name": "LoaderCircle",
                "spin": "true"
              }
            },
            {
              "type": "text",
              "class": "welcome-busy",
              "i18n": "auth.nuvio.signing_in"
            }
          ]
        },
        {
          "type": "spacer",
          "height": 20
        },
        {
          "type": "row",
          "children": [
            {
              "type": "row",
              "class": "divider",
              "grow": 1,
              "children": []
            },
            {
              "type": "text",
              "class": "welcome-or",
              "i18n": "auth.or"
            },
            {
              "type": "row",
              "class": "divider",
              "grow": 1,
              "children": []
            }
          ],
          "gap": 12
        },
        {
          "type": "spacer",
          "height": 20
        },
        {
          "type": "row",
          "class": "btn-secondary",
          "padding": "0 28",
          "justify": "center",
          "action": {
            "name": "welcome",
            "args": {
              "op": "offline"
            }
          },
          "children": [
            {
              "type": "text",
              "class": "btn-label",
              "i18n": "auth.continue_without_account"
            }
          ]
        }
      ],
      "when": "!welcome.pairing",
      "class": "desktop-only",
      "width": 440,
      "padding": "36 36 32"
    },
    {
      "type": "row",
      "children": [
        {
          "type": "column",
          "children": [
            {
              "type": "row",
              "when": "welcome.qr",
              "children": [
                {
                  "type": "qr",
                  "props": {
                    "modules": "{welcome.qr.modules}",
                    "count": "{welcome.qr.count}",
                    "size": 260
                  }
                }
              ],
              "justify": "center"
            },
            {
              "type": "spacer",
              "height": 20
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-code",
                  "text": "{welcome.code}"
                }
              ],
              "justify": "center"
            },
            {
              "type": "spacer",
              "height": 4
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-subtitle",
                  "text": "{welcome.url}"
                }
              ],
              "justify": "center"
            }
          ],
          "width": 280
        },
        {
          "type": "column",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "logo": "wordmark",
                    "size": 56
                  }
                }
              ]
            },
            {
              "type": "spacer",
              "height": 20
            },
            {
              "type": "text",
              "class": "welcome-title",
              "i18n": "auth.scan_to_connect"
            },
            {
              "type": "spacer",
              "height": 24
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_scan",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "spacer",
              "height": 10
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_login",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "spacer",
              "height": 10
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_return",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "spacer",
              "height": 24
            },
            {
              "type": "row",
              "class": "welcome-error",
              "padding": "12 16",
              "when": "welcome.error",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-error-text",
                  "text": "{welcome.error}",
                  "props": {
                    "lines": 3
                  }
                }
              ]
            },
            {
              "type": "spacer",
              "height": 24
            },
            {
              "type": "row",
              "class": "btn-secondary",
              "padding": "0 28",
              "justify": "center",
              "action": {
                "name": "welcome",
                "args": {
                  "op": "offline"
                }
              },
              "children": [
                {
                  "type": "text",
                  "class": "btn-label",
                  "i18n": "auth.continue_without_account"
                }
              ]
            }
          ],
          "width": 440
        }
      ],
      "class": "tv-only",
      "gap": 48,
      "padding": "40 48"
    },
    {
      "type": "scroll",
      "props": {
        "axis": "y"
      },
      "children": [
