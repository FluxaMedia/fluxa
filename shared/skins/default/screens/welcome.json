{
  "type": "column",
  "class": "screen fullscreen centered fullscreen-center welcome",
  "children": [
    {
      "type": "column",
      "tag": "section",
      "class": "desktop-only login",
      "children": [
        {
          "type": "column",
          "tag": "header",
          "children": [
            {
              "type": "icon",
              "props": {
                "logo": "wordmark",
                "size": 84
              }
            },
            {
              "type": "text",
              "class": "welcome-title",
              "i18n": "auth.welcome_back"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-subtitle",
                  "i18n": "auth.nuvio.subtitle",
                  "props": {
                    "lines": 2,
                    "center": "true"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "class": "welcome-error",
          "when": "welcome.error",
          "children": [
            {
              "type": "text",
              "class": "welcome-error-text",
              "text": "{welcome.error}",
              "props": {
                "lines": 3
              }
            }
          ]
        },
        {
          "type": "column",
          "tag": "section",
          "class": "field",
          "children": [
            {
              "type": "text",
              "class": "group-heading",
              "i18n": "auth.field.email"
            },
            {
              "type": "input",
              "props": {
                "key": "welcomeEmail",
                "placeholder": "you@example.com",
                "value": "{fields.welcomeEmail}",
                "kind": "text"
              },
              "class": "fill-space"
            }
          ]
        },
        {
          "type": "column",
          "tag": "section",
          "class": "field",
          "children": [
            {
              "type": "text",
              "class": "group-heading",
              "i18n": "auth.field.password"
            },
            {
              "type": "input",
              "props": {
                "key": "welcomePassword",
                "placeholder": "",
                "value": "{fields.welcomePassword}",
                "kind": "password"
              },
              "class": "fill-space"
            }
          ]
        },
        {
          "type": "row",
          "tag": "button",
          "class": "primary",
          "when": "!welcome.busy",
          "action": {
            "name": "welcome",
            "args": {
              "op": "signin"
            }
          },
          "children": [
            {
              "type": "text",
              "tag": "span",
              "i18n": "auth.log_in"
            }
          ]
        },
        {
          "type": "row",
          "tag": "button",
          "when": "welcome.busy",
          "children": [
            {
              "type": "icon",
              "tag": "i",
              "props": {
                "name": "LoaderCircle",
                "spin": "true"
              }
            },
            {
              "type": "text",
              "tag": "span",
              "class": "welcome-busy",
              "i18n": "auth.nuvio.signing_in"
            }
          ]
        },
        {
          "type": "row",
          "tag": "ul",
          "class": "or",
          "children": [
            {
              "type": "row",
              "class": "divider",
              "children": []
            },
            {
              "type": "text",
              "class": "group-heading",
              "i18n": "auth.or"
            },
            {
              "type": "row",
              "class": "divider",
              "children": []
            }
          ]
        },
        {
          "type": "row",
          "tag": "button",
          "action": {
            "name": "welcome",
            "args": {
              "op": "offline"
            }
          },
          "children": [
            {
              "type": "text",
              "tag": "span",
              "i18n": "auth.continue_without_account"
            }
          ]
        }
      ],
      "when": "!welcome.pairing"
    },
    {
      "type": "row",
      "children": [
        {
          "type": "column",
          "tag": "section",
          "class": "code",
          "children": [
            {
              "type": "row",
              "when": "welcome.qr",
              "children": [
                {
                  "type": "qr",
                  "props": {
                    "modules": "{welcome.qr.modules}",
                    "count": "{welcome.qr.count}",
                    "size": 260
                  }
                }
              ],
              "justify": "center"
            },
            {
              "type": "text",
              "class": "welcome-title",
              "text": "{welcome.code}"
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "text": "{welcome.url}"
            }
          ]
        },
        {
          "type": "column",
          "tag": "section",
          "class": "steps",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "logo": "wordmark",
                    "size": 56
                  }
                }
              ]
            },
            {
              "type": "text",
              "class": "welcome-title",
              "i18n": "auth.scan_to_connect"
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_scan",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_login",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_return",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "row",
              "class": "welcome-error",
              "when": "welcome.error",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-error-text",
                  "text": "{welcome.error}",
                  "props": {
                    "lines": 3
                  }
                }
              ]
            },
            {
              "type": "row",
              "tag": "button",
              "action": {
                "name": "welcome",
                "args": {
                  "op": "offline"
                }
              },
              "children": [
                {
                  "type": "text",
                  "tag": "span",
                  "i18n": "auth.continue_without_account"
                }
              ]
            }
          ]
        }
      ],
      "class": "tv-only pairing",
      "tag": "section"
    },
    {
      "type": "scroll",
      "props": {
        "axis": "y"
      },
      "children": [
        {
          "type": "column",
          "tag": "section",
          "class": "login phone",
          "children": [
            {
              "type": "column",
              "tag": "header",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "logo": "wordmark",
                    "size": 88
                  }
                },
                {
                  "type": "text",
                  "class": "welcome-title",
                  "i18n": "auth.welcome_back"
                },
                {
                  "type": "text",
                  "class": "welcome-subtitle",
                  "i18n": "auth.nuvio.subtitle",
                  "props": {
                    "lines": 3,
                    "center": "true"
                  }
                }
              ]
            },
            {
              "type": "row",
              "class": "welcome-error",
              "when": "welcome.error",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-error-text",
                  "text": "{welcome.error}",
                  "props": {
                    "lines": 3
                  }
                }
              ]
            },
            {
              "type": "column",
              "tag": "section",
              "class": "field",
              "children": [
                {
                  "type": "text",
                  "class": "group-heading",
                  "i18n": "auth.field.email"
                },
                {
                  "type": "input",
                  "props": {
                    "key": "welcomeEmail",
                    "placeholder": "you@example.com",
                    "value": "{fields.welcomeEmail}",
                    "kind": "text"
                  },
                  "class": "fill-space"
                }
              ]
            },
            {
              "type": "column",
              "tag": "section",
              "class": "field",
              "children": [
                {
                  "type": "text",
                  "class": "group-heading",
                  "i18n": "auth.field.password"
                },
                {
                  "type": "input",
                  "props": {
                    "key": "welcomePassword",
                    "placeholder": "",
                    "value": "{fields.welcomePassword}",
                    "kind": "password"
                  },
                  "class": "fill-space"
                }
              ]
            },
            {
              "type": "row",
              "tag": "button",
              "class": "primary",
              "when": "!welcome.busy",
              "action": {
                "name": "welcome",
                "args": {
                  "op": "signin"
                }
              },
              "children": [
                {
                  "type": "text",
                  "tag": "span",
                  "i18n": "auth.log_in"
                }
              ]
            },
            {
              "type": "row",
              "tag": "button",
              "when": "welcome.busy",
              "children": [
                {
                  "type": "icon",
                  "tag": "i",
                  "props": {
                    "name": "LoaderCircle",
                    "spin": "true"
                  }
                },
                {
                  "type": "text",
                  "tag": "span",
                  "class": "welcome-busy",
                  "i18n": "auth.nuvio.signing_in"
                }
              ]
            },
            {
              "type": "row",
              "tag": "ul",
              "class": "or",
              "children": [
                {
                  "type": "row",
                  "class": "divider",
                  "children": []
                },
                {
                  "type": "text",
                  "class": "group-heading",
                  "i18n": "auth.or"
                },
                {
                  "type": "row",
                  "class": "divider",
                  "children": []
                }
              ]
            },
            {
              "type": "row",
              "tag": "button",
              "action": {
                "name": "welcome",
                "args": {
                  "op": "offline"
                }
              },
              "children": [
                {
                  "type": "text",
                  "tag": "span",
                  "i18n": "auth.continue_without_account"
                }
              ]
            }
          ]
        }
      ],
      "when": "!welcome.pairing",
      "class": "compact-only fullscreen"
    }
  ]
}
