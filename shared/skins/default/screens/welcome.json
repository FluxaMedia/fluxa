{
  "type": "column",
  "class": "screen w-100vw h-100vh items-center justify-center",
  "children": [
    {
      "type": "column",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "icon",
              "props": {
                "logo": "wordmark",
                "size": 84
              }
            }
          ],
          "class": "justify-center"
        },
        {
          "type": "spacer",
          "class": "h-28"
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "class": "welcome-title",
              "i18n": "auth.welcome_back"
            }
          ],
          "class": "justify-center"
        },
        {
          "type": "spacer",
          "class": "h-8"
        },
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.nuvio.subtitle",
              "props": {
                "lines": 2,
                "center": "true"
              }
            }
          ]
        },
        {
          "type": "spacer",
          "class": "h-28"
        },
        {
          "type": "row",
          "class": "welcome-error",
          "when": "welcome.error",
          "children": [
            {
              "type": "text",
              "class": "welcome-error-text",
              "text": "{welcome.error}",
              "props": {
                "lines": 3
              }
            }
          ]
        },
        {
          "type": "spacer",
          "when": "welcome.error",
          "class": "h-16"
        },
        {
          "type": "text",
          "class": "welcome-label",
          "i18n": "auth.field.email"
        },
        {
          "type": "spacer",
          "class": "h-8"
        },
        {
          "type": "input",
          "props": {
            "key": "welcomeEmail",
            "placeholder": "you@example.com",
            "value": "{fields.welcomeEmail}",
            "kind": "text"
          },
          "class": "fill-space"
        },
        {
          "type": "spacer",
          "class": "h-16"
        },
        {
          "type": "text",
          "class": "welcome-label",
          "i18n": "auth.field.password"
        },
        {
          "type": "spacer",
          "class": "h-8"
        },
        {
          "type": "input",
          "props": {
            "key": "welcomePassword",
            "placeholder": "",
            "value": "{fields.welcomePassword}",
            "kind": "password"
          },
          "class": "fill-space"
        },
        {
          "type": "spacer",
          "class": "h-24"
        },
        {
          "type": "row",
          "class": "btn-primary pad-0-28 justify-center",
          "when": "!welcome.busy",
          "action": {
            "name": "welcome",
            "args": {
              "op": "signin"
            }
          },
          "children": [
            {
              "type": "text",
              "class": "btn-label",
              "i18n": "auth.log_in"
            }
          ]
        },
        {
          "type": "row",
          "class": "btn-secondary gap-10 pad-0-28 justify-center",
          "when": "welcome.busy",
          "children": [
            {
              "type": "icon",
              "props": {
                "name": "LoaderCircle",
                "spin": "true"
              }
            },
            {
              "type": "text",
              "class": "welcome-busy",
              "i18n": "auth.nuvio.signing_in"
            }
          ]
        },
        {
          "type": "spacer",
          "class": "h-20"
        },
        {
          "type": "row",
          "children": [
            {
              "type": "row",
              "class": "divider grow",
              "children": []
            },
            {
              "type": "text",
              "class": "welcome-or",
              "i18n": "auth.or"
            },
            {
              "type": "row",
              "class": "divider grow",
              "children": []
            }
          ],
          "class": "gap-12 items-center"
        },
        {
          "type": "spacer",
          "class": "h-20"
        },
        {
          "type": "row",
          "class": "btn-secondary pad-0-28 justify-center",
          "action": {
            "name": "welcome",
            "args": {
              "op": "offline"
            }
          },
          "children": [
            {
              "type": "text",
              "class": "btn-label",
              "i18n": "auth.continue_without_account"
            }
          ]
        }
      ],
      "when": "!welcome.pairing",
      "class": "desktop-only w-440 gap-0 pad-36-36-32 items-stretch"
    },
    {
      "type": "row",
      "children": [
        {
          "type": "column",
          "children": [
            {
              "type": "row",
              "when": "welcome.qr",
              "children": [
                {
                  "type": "qr",
                  "props": {
                    "modules": "{welcome.qr.modules}",
                    "count": "{welcome.qr.count}",
                    "size": 260
                  }
                }
              ],
              "class": "justify-center"
            },
            {
              "type": "spacer",
              "class": "h-20"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-code",
                  "text": "{welcome.code}"
                }
              ],
              "class": "justify-center"
            },
            {
              "type": "spacer",
              "class": "h-4"
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-subtitle",
                  "text": "{welcome.url}"
                }
              ],
              "class": "justify-center"
            }
          ],
          "class": "w-280 gap-0 items-stretch"
        },
        {
          "type": "column",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "logo": "wordmark",
                    "size": 56
                  }
                }
              ]
            },
            {
              "type": "spacer",
              "class": "h-20"
            },
            {
              "type": "text",
              "class": "welcome-title",
              "i18n": "auth.scan_to_connect"
            },
            {
              "type": "spacer",
              "class": "h-24"
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_scan",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "spacer",
              "class": "h-10"
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_login",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "spacer",
              "class": "h-10"
            },
            {
              "type": "text",
              "class": "welcome-subtitle",
              "i18n": "auth.tv.step_return",
              "props": {
                "lines": 2
              }
            },
            {
              "type": "spacer",
              "class": "h-24"
            },
            {
              "type": "row",
              "class": "welcome-error",
              "when": "welcome.error",
              "children": [
                {
                  "type": "text",
                  "class": "welcome-error-text",
