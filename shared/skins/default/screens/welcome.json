                  "props": {
                    "lines": 3
                  }
                }
              ]
            },
            {
              "type": "spacer",
              "class": "h-24"
            },
            {
              "type": "row",
              "class": "btn-secondary pad-0-28 justify-center",
              "action": {
                "name": "welcome",
                "args": {
                  "op": "offline"
                }
              },
              "children": [
                {
                  "type": "text",
                  "class": "btn-label",
                  "i18n": "auth.continue_without_account"
                }
              ]
            }
          ],
          "class": "w-440 gap-0 items-stretch"
        }
      ],
      "class": "tv-only gap-48 pad-40-48 items-center"
    },
    {
