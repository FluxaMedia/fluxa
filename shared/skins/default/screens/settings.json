{
  "type": "column",
  "class": "screen rows",
  "children": [
    {
      "type": "column",
      "class": "settings-compact",
      "when": "prefs.open",
      "children": [
        {
          "type": "row",
          "tag": "a",
          "class": "back",
          "action": {
            "name": "node",
            "args": {
              "id": "{prefs.backNode}"
            }
          },
          "when": "!prefs.inPage",
          "children": [
            {
              "type": "icon",
              "props": {
                "name": "ArrowLeft",
                "size": 18
              }
            },
            {
              "type": "text",
              "tag": "span",
              "i18n": "nav.settings"
            }
          ]
        },
        {
          "include": "settings_content"
        }
      ]
    },
    {
      "type": "column",
      "class": "settings-compact",
      "when": "!prefs.open",
      "children": [
        {
          "type": "text",
          "tag": "h1",
          "i18n": "nav.settings"
        },
        {
          "type": "input",
          "props": {
            "key": "settingsSearch",
            "placeholder": "{prefs.searchPlaceholder}",
            "value": "{fields.settingsSearch}",
            "kind": "search"
          }
        },
        {
          "type": "column",
          "tag": "ul",
          "class": "rows",
          "children": [
            {
              "each": "prefs.categories",
              "as": "cat",
              "template": {
                "type": "column",
                "tag": "section",
                "children": [
                  {
                    "type": "text",
                    "tag": "h2",
                    "text": "{cat.heading}",
                    "when": "cat.hasHeading"
                  },
                  {
                    "type": "row",
                    "tag": "li",
                    "action": {
                      "name": "choose",
                      "args": {
                        "key": "{cat.key}",
                        "value": "{cat.id}"
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "tag": "label",
                        "text": "{cat.label}",
                        "props": {
                          "lines": 1
                        }
                      },
                      {
                        "type": "icon",
                        "props": {
                          "name": "ChevronRight",
                          "size": 16
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "type": "row",
      "class": "settings-wide",
      "children": [
        {
          "type": "column",
          "tag": "nav",
          "children": [
            {
              "type": "input",
              "props": {
                "key": "settingsSearch",
                "placeholder": "{prefs.searchPlaceholder}",
                "value": "{fields.settingsSearch}",
                "kind": "search"
              }
            },
            {
              "each": "prefs.categories",
              "as": "cat",
              "template": {
                "include": "nav_entry"
              }
            }
          ]
        },
        {
          "type": "column",
          "tag": "main",
          "children": [
            {
              "include": "settings_content"
            }
          ]
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "class": "nav-dock",
          "children": [
            {
              "include": "navbar"
            }
          ]
        }
      ]
    }
  ]
}
