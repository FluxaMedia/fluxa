{
  "type": "column",
  "class": "screen items-stretch",
  "children": [
    {
      "type": "column",
      "children": [
        {
          "type": "row",
          "class": "back-link",
          "action": {
            "name": "node",
            "args": {
              "id": "{prefs.backNode}"
            }
          },
          "children": [
            {
              "type": "icon",
              "props": {
                "name": "ArrowLeft",
                "size": 18
              }
            },
            {
              "type": "text",
              "i18n": "nav.settings",
              "class": "side-label"
            }
          ],
          "when": "!prefs.inPage"
        },
        {
          "include": "settings_content"
        }
      ],
      "when": "prefs.open",
      "class": "compact-only gap-18 pad-40-16-96-16 items-stretch"
    },
    {
      "type": "column",
      "when": "!prefs.open",
      "children": [
        {
          "type": "column",
          "children": [
            {
              "type": "text",
              "i18n": "nav.settings",
              "style": "title",
              "class": "pad-8-0"
            },
            {
              "type": "input",
              "props": {
                "key": "settingsSearch",
                "kind": "search",
                "placeholder": "{prefs.searchPlaceholder}",
                "value": "{fields.settingsSearch}"
              }
            },
            {
              "each": "prefs.categories",
              "as": "cat",
              "template": {
                "type": "column",
                "children": [
                  {
                    "type": "text",
                    "when": "cat.hasHeading",
                    "text": "{cat.heading}",
                    "style": "meta muted",
                    "class": "pad-12-8-2-8"
                  },
                  {
                    "type": "row",
                    "class": "setting-row gap-12 pad-14-16",
                    "action": {
                      "name": "choose",
                      "args": {
                        "key": "{cat.key}",
                        "value": "{cat.id}"
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "text": "{cat.label}",
                        "props": {
                          "lines": 1
                        },
                        "class": "grow"
                      },
                      {
                        "type": "icon",
                        "props": {
                          "name": "ChevronRight",
                          "size": 16
                        }
                      }
                    ]
                  }
                ],
                "class": "gap-6 items-stretch"
              }
            }
          ],
          "class": "gap-6 items-stretch"
        }
      ],
      "class": "compact-only gap-8 pad-48-16-96-16 items-stretch"
    },
    {
      "type": "row",
      "children": [
        {
          "type": "column",
          "children": [
            {
              "type": "input",
              "props": {
                "key": "settingsSearch",
                "kind": "search",
                "placeholder": "{prefs.searchPlaceholder}",
                "value": "{fields.settingsSearch}"
              }
            },
            {
              "each": "prefs.categories",
              "as": "cat",
              "template": {
                "include": "nav_entry"
              }
            }
          ],
          "class": "side-panel"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "settings_content"
            }
          ],
          "class": "settings-page"
        }
      ],
      "class": "wide-only h-100vh gap-0 items-stretch justify-start"
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "w-100vw h-100vh pad-0-0-16-0 items-center justify-flex-end compact-only nav-dock"
        }
      ]
    }
  ]
}
