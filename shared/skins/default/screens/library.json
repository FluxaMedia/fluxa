{
  "type": "column",
  "class": "screen library",
  "children": [
    {
      "type": "spacer",
      "class": "lead"
    },
    {
      "type": "page",
      "children": [
        {
          "type": "row",
          "tag": "header",
          "class": "fill-space",
          "children": [
            {
              "type": "text",
              "tag": "h1",
              "i18n": "auto.my_library"
            },
            {
              "type": "input",
              "props": {
                "key": "librarySearch",
                "placeholder": "Filter",
                "value": "{fields.librarySearch}",
                "kind": "search"
              },
              "class": "wide-only search"
            },
            {
              "type": "input",
              "props": {
                "key": "librarySearch",
                "placeholder": "Filter",
                "value": "{fields.librarySearch}",
                "kind": "search"
              },
              "class": "compact-only grow"
            }
          ]
        },
        {
          "include": "section_tabs"
        },
        {
          "type": "row",
          "tag": "section",
          "class": "filters",
          "children": [
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"libraryStatus\"",
                "value": "library.tab",
                "options": "library.statusOptions",
                "width": "180"
              },
              "when": "len(library.statusOptions) > 0"
            },
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"libraryType\"",
                "value": "library.type",
                "options": "library.typeOptions",
                "width": "180"
              }
            },
            {
              "include": "dropdown_filter",
              "with": {
                "key": "\"librarySort\"",
                "value": "library.sort",
                "options": "library.sortOptions",
                "width": "180"
              }
            }
          ],
          "when": "!library.downloadsOpen"
        },
        {
          "type": "row",
          "class": "divider fill-space",
          "when": "!library.downloadsOpen"
        },
        {
          "include": "empty_state",
          "with": {
            "icon": "\"Library\"",
            "title": "\"library.empty\"",
            "hint": "\"library.add_titles_hint\""
          },
          "when": "library.isEmpty"
        },
        {
          "type": "row",
          "tag": "section",
          "class": "toolbar",
          "when": "library.downloads.open",
          "children": [
            {
              "type": "row",
              "class": "icon-btn",
              "children": [
                {
                  "type": "icon",
                  "props": {
                    "name": "ArrowLeft"
                  }
                }
              ],
              "action": {
                "name": "downloads",
                "args": {
                  "op": "back",
                  "id": "-"
                }
              }
            },
            {
              "type": "text",
              "tag": "h1",
              "text": "{library.downloads.openTitle}"
            }
          ]
        },
        {
          "type": "row",
          "tag": "section",
          "class": "toolbar",
          "when": "library.downloadsOpen",
          "children": [
            {
              "type": "text",
              "tag": "small",
              "text": "{library.downloads.speed}"
            },
            {
              "type": "text",
              "tag": "small",
              "text": "{library.downloads.location}",
              "when": "!library.downloads.open"
            },
            {
              "type": "row",
              "class": "chip",
              "action": {
                "name": "downloads",
                "args": {
                  "op": "location",
                  "id": "-"
                }
              },
              "when": "!library.downloads.open",
              "children": [
                {
                  "type": "text",
                  "i18n": "downloads.change",
                  "style": "meta"
                }
              ]
            }
          ]
        },
        {
          "type": "column",
          "when": "library.downloads.listing",
          "children": [
            {
              "each": "library.downloads.groups",
              "as": "group",
              "template": {
                "include": "download_group"
              }
            }
          ],
          "class": "section"
        },
        {
          "type": "column",
          "when": "library.downloads.open",
          "children": [
            {
              "each": "library.downloads.rows",
              "as": "row",
              "template": {
                "include": "download_row"
              }
            }
          ],
          "class": "section"
        },
        {
          "include": "empty_state",
          "with": {
            "icon": "\"Downloads\"",
            "title": "\"library.downloads_empty\"",
            "hint": "\"\""
          },
          "when": "library.downloads.none"
        },
        {
          "type": "spacer",
          "class": "compact-only tail"
        }
      ],
      "class": "page-dense listing"
    },
    {
      "type": "grid",
      "class": "poster-grid",
      "children": [
        {
          "each": "library.cards",
          "as": "card",
          "template": {
            "include": "card"
          }
        }
      ],
      "when": "!library.downloadsOpen"
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "compact-only nav-dock"
        }
      ]
    }
  ]
}
