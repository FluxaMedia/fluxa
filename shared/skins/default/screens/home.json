{
  "type": "column",
  "class": "screen",
  "gap": 16,
  "align": "stretch",
  "children": [
    {
      "type": "row",
      "justify": "center",
      "padding": 12,
      "children": [
        {
          "include": "navbar"
        }
      ],
      "when": "len(home.heroSlides) == 0"
    },
    {
      "type": "pager",
      "props": {
        "interval": 8
      },
      "when": "len(home.heroSlides) > 0",
      "children": [
        {
          "each": "home.heroSlides",
          "as": "slide",
          "template": {
            "include": "hero_slide"
          }
        }
      ]
    },
    {
      "type": "column",
      "gap": 20,
      "padding": 24,
      "children": [
        {
          "each": "home.rows",
          "as": "row",
          "template": {
            "include": "shelf"
          }
        }
      ]
    }
  ]
}
