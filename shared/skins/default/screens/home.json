{
  "type": "column",
  "class": "screen",
  "children": [
    {
      "type": "column",
      "class": "hero-skeleton",
      "when": "len(home.heroSlides) == 0 && home.isLoading"
    },
    {
      "type": "column",
      "tag": "section",
      "class": "empty-home",
      "when": "len(home.heroSlides) == 0 && len(home.rows) == 0 && len(home.cards) == 0 && !home.isLoading",
      "children": [
        {
          "include": "empty_state",
          "with": {
            "icon": "\"Discover\"",
            "title": "\"home.no_catalogs\"",
            "hint": "\"home.no_catalogs_hint\""
          }
        },
        {
          "type": "row",
          "tag": "button",
          "class": "primary",
          "action": {
            "name": "open_settings",
            "args": {
              "page": "{home.addonsPage}"
            }
          },
          "children": [
            {
              "type": "text",
              "tag": "span",
              "i18n": "home.open_addons"
            }
          ]
        }
      ]
    },
    {
      "type": "pager",
      "props": {
        "interval": 8
      },
      "when": "len(home.heroSlides) > 0",
      "children": [
        {
          "each": "home.heroSlides",
          "as": "slide",
          "template": {
            "include": "hero_slide"
          }
        }
      ]
    },
    {
      "type": "column",
      "tag": "section",
      "class": "feed",
      "when": "len(home.rows) == 0",
      "children": [
        {
          "type": "column",
          "tag": "section",
          "class": "skeleton",
          "when": "home.isLoading",
          "children": [
            {
              "type": "column",
              "tag": "h1",
              "class": "skeleton-bar"
            },
            {
              "type": "column",
              "tag": "p",
              "class": "skeleton-bar"
            },
            {
              "type": "column",
              "tag": "h2",
              "class": "skeleton-bar cta"
            },
            {
              "include": "skeleton_shelf"
            },
            {
              "include": "skeleton_shelf"
            }
          ]
        }
      ]
    },
    {
      "type": "column",
      "tag": "section",
      "class": "feed",
      "children": [
        {
          "type": "row",
          "tag": "ul",
          "when": "len(home.categories) > 1",
          "children": [
            {
              "each": "home.categories",
              "as": "c",
              "template": {
                "type": "row",
                "children": [
                  {
                    "type": "row",
                    "class": "chip-active",
                    "action": {
                      "name": "node",
                      "args": {
                        "id": "{c.node}"
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "tag": "label",
                        "i18n": "{c.label}"
                      }
                    ],
                    "when": "c.active"
                  },
                  {
                    "type": "row",
                    "class": "chip",
                    "action": {
                      "name": "node",
                      "args": {
                        "id": "{c.node}"
                      }
                    },
                    "children": [
                      {
                        "type": "text",
                        "tag": "label",
                        "i18n": "{c.label}"
                      }
                    ],
                    "when": "!c.active"
                  }
                ]
              }
            }
          ]
        },
        {
          "include": "skeleton_shelf",
          "when": "len(home.cards) == 0 && home.isLoading"
        },
        {
          "include": "continue_shelf",
          "when": "len(home.cards) > 0"
        },
        {
          "each": "home.rows",
          "as": "row",
          "window": true,
          "initial": 6,
          "flow": true,
          "template": {
            "include": "shelf"
          }
        }
      ]
    },
    {
      "type": "fixed",
      "children": [
        {
          "include": "navbar",
          "class": "wide-only"
        },
        {
          "type": "column",
          "children": [
            {
              "include": "navbar"
            }
          ],
          "class": "compact-only nav-dock"
        }
      ]
    }
  ]
}
