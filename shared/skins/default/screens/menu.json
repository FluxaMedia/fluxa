{
  "type": "fixed",
  "children": [
    {
      "type": "stack",
      "children": [
        {
          "type": "column",
          "class": "menu-scrim",
          "fill": true,
          "action": {
            "name": "menu_dismiss"
          }
        },
        {
          "type": "fixed",
          "props": {
            "x": "{menu.x}",
            "y": "{menu.y}"
          },
          "children": [
            {
              "type": "column",
              "class": "menu-panel gap2-items-stretch",
              "width": "{const.menuWidth}",
              "padding": "{const.menuPadding}",
              "children": [
                {
                  "type": "text",
                  "when": "menu.title",
                  "class": "menu-title",
                  "text": "{menu.title}",
                  "props": {
                    "lines": 1
                  }
                },
                {
                  "each": "menu.items",
                  "as": "item",
                  "template": {
                    "type": "row",
                    "class": "select-row gap10",
                    "props": {
                      "selected": "{item.selected}"
                    },
                    "action": {
                      "name": "menu_pick",
                      "args": {
                        "index": "{item.index}"
                      }
                    },
                    "children": [
                      {
                        "type": "icon",
                        "when": "item.icon",
                        "props": {
                          "name": "{item.icon}",
                          "size": 18
                        }
                      },
                      {
                        "type": "text",
                        "text": "{item.label}",
                        "props": {
                          "lines": 1
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "class": "only-desktop"
        },
        {
          "type": "fixed",
          "props": {
            "x": 0,
            "y": 0,
            "anchor": "bottom"
          },
          "children": [
            {
              "type": "column",
              "class": "menu-panel menu-sheet w100vw-gap2-items-stretch",
              "padding": "{const.menuPadding}",
              "children": [
                {
                  "type": "text",
                  "when": "menu.title",
                  "class": "menu-title",
                  "text": "{menu.title}",
                  "props": {
                    "lines": 1
                  }
                },
                {
                  "each": "menu.items",
                  "as": "item",
                  "template": {
                    "type": "row",
                    "class": "select-row gap10",
                    "props": {
                      "selected": "{item.selected}"
                    },
                    "action": {
                      "name": "menu_pick",
                      "args": {
                        "index": "{item.index}"
                      }
                    },
                    "children": [
                      {
                        "type": "icon",
                        "when": "item.icon",
                        "props": {
                          "name": "{item.icon}",
                          "size": 18
                        }
                      },
                      {
                        "type": "text",
                        "text": "{item.label}",
                        "props": {
                          "lines": 1
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "class": "only-mobile"
        },
        {
          "type": "fixed",
          "children": [
            {
              "type": "column",
              "class": "menu-panel gap2-items-stretch",
              "width": "{const.menuWidth}",
              "padding": "{const.menuPadding}",
              "children": [
                {
                  "type": "text",
                  "when": "menu.title",
                  "class": "menu-title",
                  "text": "{menu.title}",
                  "props": {
                    "lines": 1
                  }
                },
                {
                  "each": "menu.items",
                  "as": "item",
                  "template": {
                    "type": "row",
                    "class": "select-row gap10",
                    "props": {
                      "selected": "{item.selected}"
                    },
                    "action": {
                      "name": "menu_pick",
                      "args": {
                        "index": "{item.index}"
                      }
                    },
                    "children": [
                      {
                        "type": "icon",
                        "when": "item.icon",
                        "props": {
                          "name": "{item.icon}",
                          "size": 18
                        }
                      },
                      {
                        "type": "text",
                        "text": "{item.label}",
                        "props": {
                          "lines": 1
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "class": "only-tv"
        }
      ],
      "class": "stack-w100vw-h100vh"
    }
  ]
}
