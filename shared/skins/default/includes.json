{
  "navbar": {
    "type": "row",
    "class": "navbar",
    "gap": 4,
    "padding": 6,
    "align": "center",
    "children": [
      {
        "each": "nav.items",
        "as": "item",
        "template": {
          "type": "row",
          "class": "{item.class}",
          "padding": 10,
          "action": {
            "name": "navigate",
            "args": {
              "screen": "{item.screen}"
            }
          },
          "children": [
            {
              "type": "icon",
              "props": {
                "name": "{item.icon}",
                "size": 22
              }
            }
          ]
        }
      },
      {
        "type": "avatar",
        "props": {
          "image": "{home.profileAvatarUrl}",
          "name": "{home.profileName}",
          "size": 34
        },
        "action": {
          "name": "open_settings"
        }
      }
    ]
  },
  "card": {
    "type": "poster_card",
    "props": {
      "title": "{card.title}",
      "subtitle": "{card.subtitle}",
      "image": "{card.artworkUrl}",
      "progress": "{card.progress}",
      "shape": "{card.collectionShape}",
      "hideTitle": "{card.hideTitle}",
      "motion": "{card.motionUrl}",
      "motionEnabled": "{card.motionEnabled}",
      "autoplay": "{home.gifAutoplayEnabled}"
    },
    "action": {
      "name": "open_detail",
      "args": {
        "id": "{card.id}",
        "type": "{card.itemType}"
      }
    }
  },
  "hero_slide": {
    "type": "stack",
    "class": "hero",
    "height": "62vh",
    "children": [
      {
        "type": "image",
        "src": "{slide.backgroundUrl}",
        "props": {
          "fit": "cover",
          "focus": 0.2
        }
      },
      {
        "type": "hero_scrim"
      },
      {
        "type": "column",
        "class": "hero-content",
        "gap": 12,
        "padding": 24,
        "justify": "end",
        "align": "start",
        "children": [
          {
            "type": "title_logo",
            "props": {
              "logo": "{slide.logoUrl}",
              "title": "{slide.title}"
            }
          },
          {
            "type": "text",
            "class": "hero-meta",
            "style": "meta muted",
            "text": "{slide.eyebrow}"
          },
          {
            "type": "row",
            "gap": 12,
            "align": "center",
            "children": [
              {
                "type": "button",
                "i18n": "menu.play",
                "props": {
                  "variant": "primary"
                },
                "action": {
                  "name": "play",
                  "args": {
                    "id": "{slide.itemId}",
                    "type": "{slide.itemType}"
                  }
                }
              },
              {
                "type": "button",
                "i18n": "auto.watchlist",
                "props": {
                  "variant": "secondary"
                },
                "action": {
                  "name": "watchlist_toggle",
                  "args": {
                    "id": "{slide.itemId}",
                    "type": "{slide.itemType}"
                  }
                }
              }
            ]
          }
        ],
        "fill": true
      },
      {
        "type": "column",
        "fill": true,
        "align": "center",
        "padding": 12,
        "children": [
          {
            "include": "navbar"
          }
        ]
      }
    ]
  },
  "shelf": {
    "type": "column",
    "class": "shelf",
    "gap": 8,
    "children": [
      {
        "type": "text",
        "class": "shelf-title",
        "style": "title",
        "text": "{row.title} - {row.typeLabel}",
        "when": "row.typeLabel"
      },
      {
        "type": "text",
        "class": "shelf-title",
        "style": "title",
        "text": "{row.title}",
        "when": "!row.typeLabel"
      },
      {
        "type": "scroll",
        "gap": 16,
        "children": [
          {
            "each": "row.cards",
            "as": "card",
            "limit": 30,
            "template": {
              "include": "card"
            }
          }
        ]
      }
    ]
  },
  "continue_shelf": {
    "type": "column",
    "class": "shelf",
    "gap": 8,
    "children": [
      {
        "type": "text",
        "class": "shelf-title",
        "style": "title",
        "i18n": "auto.continue_watching"
      },
      {
        "type": "scroll",
        "gap": 16,
        "children": [
          {
            "each": "home.cards",
            "as": "card",
            "limit": 30,
            "template": {
              "type": "continue_card",
              "props": {
                "title": "{card.title}",
                "subtitle": "{card.subtitle}",
                "image": "{card.artworkUrl}",
                "progress": "{card.progress}"
              },
              "action": {
                "name": "play",
                "args": {
                  "id": "{card.id}",
                  "type": "{card.itemType}"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
