{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fluxa theme.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "backgroundElevated": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "surfaceRaised": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "navigation": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "textPrimary": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "textSecondary": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "textMuted": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "border": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "borderStrong": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "accentForeground": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "success": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "warning": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "error": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "info": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "focus": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "scrim": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "buttonPrimary": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "buttonPrimaryText": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "cardBackground": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "inputBackground": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "inputBorder": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        },
        "inputBorderFocus": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3,4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$|^rgba?\\(.+\\)$"
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cardRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "controlRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "dialogRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenPadding": {
          "type": "number",
          "minimum": 0,
          "maximum": 96
        },
        "sectionGap": {
          "type": "number",
          "minimum": 0,
          "maximum": 96
        },
        "controlGap": {
          "type": "number",
          "minimum": 0,
          "maximum": 96
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fastMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "normalMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "slowMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        }
      }
    },
    "vars": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hideRows": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rowOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "heroActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "play",
              "watchlist"
            ]
          },
          "uniqueItems": true
        },
        "detailActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "play",
              "watchlist",
              "shuffle",
              "completed",
              "dropped"
            ]
          },
          "uniqueItems": true
        },
        "navItems": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "home",
              "discover",
              "library"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "base": {
      "enum": [
        "fluxa-dark",
        "amoled",
        "midnight-blue"
      ]
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regular": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "semibold": {
          "type": "string"
        },
        "bold": {
          "type": "string"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string"
        }
      }
    }
  }
}
