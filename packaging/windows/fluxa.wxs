<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Fluxa" Manufacturer="Fluxa" Version="$(var.Version)" UpgradeCode="3D8B5C70-92A4-4E1B-A6F3-0C7D1E9B4A52" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Fluxa is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="FluxaIcon" SourceFile="..\icons\fluxa.ico" />
    <Property Id="ARPPRODUCTICON" Value="FluxaIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Fluxa" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Fluxa" Level="1">
      <Files Include="$(var.SourceDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="9E4A7B13-5D20-4C68-8F1A-2B6C3D0E7A94">
        <Shortcut Id="FluxaShortcut" Name="Fluxa" Target="[INSTALLFOLDER]fluxa-desktop.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Fluxa" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Package>
</Wix>
